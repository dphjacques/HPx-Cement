-fig_group "Heat"
-fig_name "Heat rate - kJ/d"
-fig_x Lead
-fig_y hTotal < k "Sum"   style lines >
-fig_y hCement < k "Clinkers / SCM"   style lines dt 2 >
-fig_y hHydrates < k "Hydrates"   style lines dt 2>
-fig_yt "Heat rate [kJ/d]" 
-fig_start 

-fig_end 
-fig_variant y "Per 100 g"  "_THIS *100/ Cement_Recipe_Amount" "Volume [cm^3 / 100g cement]"
-fig_variant x "per hour"   "_THIS * 24" "Time [hour]"