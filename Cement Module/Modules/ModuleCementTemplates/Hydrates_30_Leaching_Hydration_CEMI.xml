<Template>
	<Description>Hydration followed by leaching of cementitious materials (CEMI)</Description>
	<MetaData> </MetaData>
	<Databases>
		<DatabaseGroup>_managed_</DatabaseGroup>
		<DatabaseName>_CEMDATA_CEMDATA18-31-03-2022-phaseVol.dat</DatabaseName>
	</Databases>
	<ThermodynamicData>
		<ImportFiles>
			<ImportFile>
				<Name>Zeolite-Na-Ca-K-Phreeqc version_2021.txt</Name>
				<ProjectGroup>false</ProjectGroup>
				<RelativePath>true</RelativePath>
				<Use>true</Use>
				<Directory>3003</Directory>
				<Format>1001</Format>
				<Type>2000</Type>
			</ImportFile>
		</ImportFiles>
	</ThermodynamicData>
	<InputTable>
		<File>ModuleCement_Input_01_ModelSystem.xml</File>
        <File>ModuleCement_Input_03_Recipe-mineral.xml</File>
        <File>ModuleCement_Input_40_Hydration_01_CEMI.xml</File>
		<File>ModuleCement_Input_20_Leaching.xml</File>
		<File>ModuleCement_Output_03_Leaching.xml</File>
	</InputTable>
	<DataBlocks>		
        <DataBlock>
            <Name>OPC_min</Name>
            <Description>Composition of OPC CELMI in terms of weight percentages of constituents (clinkers, soluble minerals)</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_min.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_alite</Name>
            <Description>Oxide composition of alite</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_alite.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_belite</Name>
            <Description>Oxide composition of belite</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_bellite.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_aluminate</Name>
            <Description>Oxide composition of aluminate</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_aluminate.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_ferrite</Name>
            <Description>Oxide composition of ferrite</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_ferrite.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_alite_PK</Name>
            <Description>Parameters for the Parrot-Killoch model for hydration of alite</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_alite_PK.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_belite_PK</Name>
            <Description>Parameters for the Parrot-Killoch model for hydration of belite</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_belite_PK.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_aluminate_PK</Name>
            <Description>Parameters for the Parrot-Killoch model for hydration of aluminate</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_aluminate_PK.xml</File>
        </DataBlock>
        <DataBlock>
            <Name>OPC_ferrite_PK</Name>
            <Description>Parameters for the Parrot-Killoch model for hydration of ferrite</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_ferrite_PK.xml</File>
        </DataBlock>    
		<DataBlock>
			<Name>LeachingSolution</Name>
			<Description>Chemical composition of Leaching solutions</Description>
			<Use>true</Use>
			<Import>true</Import>
			<RelPath>true</RelPath>
			<Folder>Data</Folder>
			<File>LeachingSolution.xml</File>
		</DataBlock>
		<DataBlock>
			<Name>LeachingName</Name>
			<Description></Description>
			<Use>true</Use>
			<Import>true</Import>
			<RelPath>true</RelPath>
			<Folder>Data</Folder>
			<File>LeachingName.xml</File>
		</DataBlock>
	</DataBlocks>
	<Transformation></Transformation>
	<Additions><![CDATA[include$ ModuleCement_PhreeqcInput_01_AdditionsToDatabase.hpi]]></Additions>
	<Geochemistry><![CDATA[include$ ModuleCement_PhreeqcInput_10_Geochemistry_20_Leaching_Hydration.hpi]]></Geochemistry>
</Template>
