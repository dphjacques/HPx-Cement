        <File>ModuleCement_Input_03_Recipe-mineral-SCM.xml</File>
        <File>ModuleCement_Input_40_Hydration_10_SCM.xml</File>
        <File>ModuleCement_Output_02_Hydration.xml</File>
    </InputTable>
    <DataBlocks>
        <DataBlock>
            <Name>OPC_min</Name>
            <Description>Chemical composition of Ordinary Portland Cement in mineral amounts</Description>
            <Use>true</Use>
            <Import>true</Import>
            <RelPath>true</RelPath>
            <Folder>Data</Folder>
            <File>OPC_min.xml</File>
