<Template>
    <Description>Hydration of blended cement OPC clinkers and SCMs</Description>
    <MetaData> </MetaData>
    <Databases>
        <DatabaseGroup>_managed_</DatabaseGroup>
        <DatabaseName>_CEMDATA_CEMDATA18-31-03-2022-phaseVol.dat</DatabaseName>
    </Databases>
    <ThermodynamicData>
        <ImportFiles>
            <ImportFile>
                <Name>Zeolite-Na-Ca-K-Phreeqc version_2021.txt</Name>
                <ProjectGroup>false</ProjectGroup>
                <RelativePath>true</RelativePath>
                <Use>true</Use>
                <Directory>3003</Directory>
                <Format>1001</Format>
                <Type>2000</Type>
            </ImportFile>
        </ImportFiles>
    </ThermodynamicData>
