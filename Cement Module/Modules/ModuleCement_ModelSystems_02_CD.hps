class SolidSolutionModel
    var EndMember = list()
    ideal = true
    x1 = 0 #Mole fraction comp 2 at one end of miscibility gap
    x2 = 0 #Mole fraction comp 2 at other end of miscibility gap
    
    def WritePhreeqcSolidSolution()
        txt = ""
        if(ideal) then
            for min in EndMember
                txt = txt + " -comp " + min + " 0 " + eol
            next
        else
        txt = txt + "-comp1 " + EndMember(0) + " 0 " + eol
        txt = txt + "-comp2 " + EndMember(1) + " 0 " + eol
            txt = txt + "-miscibility_gap " + str(x1) + " " + str(x2) + " " + eol
        endif
        return txt
    enddef
endclass

import "ModuleCement_Reaction.hpi"

class CementModelSystem

    var ZeolitesNa = list()
    var ZeolitesK = list()
    var ZeolitesCa = list()
    
    push(ZeolitesNa,"ANA")
    push(ZeolitesNa,"PHI(Na)")
    push(ZeolitesNa,"LTA(Na)")
    push(ZeolitesNa,"4A")
    push(ZeolitesNa,"SOD(OH)")
    push(ZeolitesNa,"CHA(Na)")
    push(ZeolitesNa,"FAU-X(Na)")
    push(ZeolitesNa,"FAU-Y(Na)")
    push(ZeolitesNa,"NAT")
    push(ZeolitesNa,"MOR(Na)")
    push(ZeolitesNa,"PHI(NaK)") 

    push(ZeolitesK,"CHA(K)")
    push(ZeolitesK,"CLI(K)")
    push(ZeolitesK,"FAU-X(K)")
    push(ZeolitesK,"FAU-Y(K)")
    push(ZeolitesK,"GIS-LSP(K)")
    push(ZeolitesK,"GIS-P1(K)")
    push(ZeolitesK,"HEU(K)")
    push(ZeolitesK,"LEU")
    push(ZeolitesK,"LTA(K)")
    push(ZeolitesK,"MOR(K)")
    push(ZeolitesK,"NAT(K)")
    push(ZeolitesK,"PHI(K)")
    push(ZeolitesK,"STI(K)")
    push(ZeolitesK,"Tetra-NAT(K) ")

    push(ZeolitesCa,"CHA(Ca)")
    push(ZeolitesCa,"CLI(Ca)")
    push(ZeolitesCa,"HEU(Ca)-1")
    push(ZeolitesCa,"HEU(Ca)-2")
    push(ZeolitesCa,"MOR(Ca)")
    push(ZeolitesCa,"SCO")
    push(ZeolitesCa,"STI(Ca)")
    push(ZeolitesCa,"GIS-LS-P(Ca)")
    
    clear_def("Db_Kinetics")
    
    def GetSystemPhreeqc(nr)
    cemsys = get(CementModels,nr)
      return cemsys.WritePhreeqcCementModel(1001)
    enddef 
    
    def GetCementModel(nr)
    return get(CementModels,nr)
    enddef
    
    def CreateHeadings(nr)
    
        cemsys = get(CementModels,nr)
        txt = ""
        clear_def("Db_Elements")
        txto= ""
        for i in cemsys.Elements
            txt = txt + i + " "
            push_def("Db_Elements",i)
            if(i="Ca") then txto = txto + "CaO " endif
            if(i="Si") then txto = txto + "SiO2 " endif
            if(i="Al") then txto = txto + "Al2O3 " endif
            if(i="S") then txto = txto + "SO3 " endif
            if(i="C") then txto = txto + "CO2 " endif
            if(i="Mg") then txto = txto + "MgO " endif
            if(i="Na") then txto = txto + "Na2O " endif
            if(i="K") then txto = txto + "K2O " endif
            if(i="Fe") then txto = txto + "Fe2O3 " endif
            if(i="Cl") then txto = txto + "Cl_t " endif   
            if(i="N") then txto = txto + "N_t " endif   
        next i 
        put_var("Output::Elements",txt)  
        put_var("Output::Oxides",txto)
        txt = ""
        txtv = ""
        txtw = ""
        clear_def("Db_Minerals")
        for i in cemsys.PurePhases
            txt = txt + i + " "
            txtv = txtv + "v" + i + " "
            txtw = txtw + "w" + i + " "
            push_def("Db_Minerals",i)
        next i 
        put_var("Output::Phases",txt)
        put_var("Output::Phasesv",txtv)
        put_var("Output::Phasesw",txtw)
        
        bheat = 0
        if(get_varexist("Cement::Output::Hydrates::CumHeat") = 0) then
           bheat = get_var("Cement::Output::Hydrates::CumHeat")
        endif
        txt = ""
        txtv = ""
        txtw = ""
        txts = ""
        txtsv = ""
        txtsw = ""
        txtsh = ""
        clear_def("Db_SolidSolutions")
        clear_def("Db_SolidSolutions_Def")
        if(get_defexist("Db_SolidSolutions_Comp",0,0)>-2) then 
            clear_def("Db_SolidSolutions_Comp")
        endif
        nr = 0
        for solsol in cemsys.SolidSolution
            solsol1 = cemsys.SolidSolution(solsol)
            nri=0
            txts = txts + solsol + " "
            txtsv = txtsv + "v" + solsol + " "
            txtsw = txtsw + "w" + solsol + " "
            for i in solsol1.EndMember
                txt = txt + i + " "
                txtv = txtv + "v" + i + " "
                txtw = txtw + "w" + i + " "
                txtsh = txtsh + "h" + i + " "
                if(bheat = 1 ) then
                    txtsh  = txtsh + "ch" + i + " "
                endif
                push_def("Db_SolidSolutions",i)
                put_def("Db_SolidSolutions_Comp",i,nr,nri)
                nri = nri+1
            next i
            push_def("Db_SolidSolutions_Def",solsol,nri)
            nr = nr+1
        next  
        put_var("Output::SolidSolutions",txt)
        put_var("Output::SolidSolutionsv",txtv)
        put_var("Output::SolidSolutionsw",txtw)
        put_var("Output::SolidSolutionsComp",txts)
        put_var("Output::SolidSolutionsCompv",txtsv)
        put_var("Output::SolidSolutionsCompw",txtsw)
        if(get_varexist("Cement::Output::Hydrates::Heat") = 0 ) then
            if(get_var("Cement::Output::Hydrates::Heat") = 1 ) then
                put_var("Output::HeatSolSol",txtsh)
            endif
        endif
        
        if(get_varexist("Cement::Output::Hydrates::SaturationIndex") = 0 ) then
            if(get_var("Cement::Output::Hydrates::SaturationIndex") = 1 ) then
                txt = " "
                for i in cemsys.PurePhases
                    txt = txt + "si" + i + " "
                next i 
                put_var("Output::Phasessi",txt)
            endif
        endif       
        
        if(get_varexist("Cement::Output::Hydrates::Heat") = 0 ) then
            txtheata = " "
            if(get_var("Cement::Output::Hydrates::Heat") = 1 ) then
                txt = " "
                for i in cemsys.PurePhases
                    txt = txt + "h" + i + " "
                    if(bheat = 1 ) then
                        txt  = txt + "ch" + i + " "
                    endif
                next i 
                put_var("Output::HeatPhases",txt)
                txtheata = txtheata + "hHydrates hCement  hTotal"
            endif
            if(bheat = 1 ) then
                txtheata  = txtheata + " chHydrates chCement  chTotal"
            endif
            put_var("Output::HeatSums",txtheata)
        else
            put_var("Output::HeatSums"," ")
        endif

        
       #zeolites
       txt = " "
       clear_def("Db_ZeolitesNa")
       if (get_varexist("Cement::Model::Zeolites::Na") = 0) then
        if (get_var("Cement::Model::Zeolites::Na") = 1) then
            for zeo in ZeolitesNa
               am = phase_formula(zeo,"count_ph","elt_ph$","coef_ph") 
               nao = 0
               ko = 0
               cao = 0
               sio = 0
               alo = 0
               for i = 1 to count_ph
                   if(elt_ph$(i)="Na" ) then nao = coef_ph(i) endif
                   if(elt_ph$(i)="K" )  then ko = coef_ph(i) endif
                   if(elt_ph$(i)="Ca" ) then cao = coef_ph(i) endif
                   if(elt_ph$(i)="Si" ) then sio = coef_ph(i) endif
                   if(elt_ph$(i)="Al" ) then alo = coef_ph(i) endif
               next i
               push_def("Db_ZeolitesNa",zeo,nao,ko,cao,sio,alo)
            next
            txt = txt + " ZNaNa ZNaSi ZNaAl " 
         endif
        endif
        clear_def("Db_ZeolitesK")
        if (get_varexist("Cement::Model::Zeolites::K") = 0) then
          if (get_var("Cement::Model::Zeolites::K") = 1) then
             for zeo in ZeolitesK
               am = phase_formula(zeo,"count_ph","elt_ph$","coef_ph") 
               nao = 0
               ko = 0
               cao = 0
               sio = 0
               alo = 0
               for i = 1 to count_ph
                   if(elt_ph$(i)="Na" ) then nao = coef_ph(i) endif
                   if(elt_ph$(i)="K" )  then ko = coef_ph(i) endif
                   if(elt_ph$(i)="Ca" ) then cao = coef_ph(i) endif
                   if(elt_ph$(i)="Si" ) then sio = coef_ph(i) endif
                   if(elt_ph$(i)="Al" ) then alo = coef_ph(i) endif
               next i
               push_def("Db_ZeolitesK",zeo,nao,ko,cao,sio,alo)
            next
            txt = txt + " ZKNa ZKSi ZKAl " 
          endif
        endif
        clear_def("Db_ZeolitesCa")
        if (get_varexist("Cement::Model::Zeolites::Ca") = 0) then
           if (get_var("Cement::Model::Zeolites::Ca") = 1) then
             for zeo in ZeolitesCa
               am = phase_formula(zeo,"count_ph","elt_ph$","coef_ph") 
               nao = 0
               ko = 0
               cao = 0
               sio = 0
               alo = 0
               for i = 1 to count_ph
                   if(elt_ph$(i)="Na" ) then nao = coef_ph(i) endif
                   if(elt_ph$(i)="K" )  then ko = coef_ph(i) endif
                   if(elt_ph$(i)="Ca" ) then cao = coef_ph(i) endif
                   if(elt_ph$(i)="Si" ) then sio = coef_ph(i) endif
                   if(elt_ph$(i)="Al" ) then alo = coef_ph(i) endif
               next i
               push_def("Db_ZeolitesCa",zeo,nao,ko,cao,sio,alo)
            next
            txt = txt + " ZCaNa ZCaSi ZCaAl " 
            endif
       endif
       put_var("Output::Zeolites",txt)
       
    enddef
    
    #definition CSHQ model
    s_sModels = Dict()
    cshq = new(SolidSolutionModel)
    push(cshq.EndMember,"CSHQ-JenD")
    push(cshq.EndMember,"CSHQ-JenH")
    push(cshq.EndMember,"CSHQ-TobD")
    push(cshq.EndMember,"CSHQ-TobH")
    set(s_sModels,"cshq",cshq)
    cshqnk = new(SolidSolutionModel)
    push(cshqnk.EndMember,"CSHQ-JenD")
    push(cshqnk.EndMember,"CSHQ-JenH")
    push(cshqnk.EndMember,"CSHQ-TobD")
    push(cshqnk.EndMember,"CSHQ-TobH")
    push(cshqnk.EndMember,"KSiOH")
    push(cshqnk.EndMember,"NaSiOH")
    set(s_sModels,"cshqnk",cshqnk)
    #MSH
    msh = new(SolidSolutionModel)
    push(msh.EndMember,"M075SH")
    push(msh.EndMember,"M15SH")
    set(s_sModels,"msh",msh)    

    #define AFt-SO4 AFT-CO3 model
    aft = new(SolidSolutionModel)
    push(aft.EndMember,"Ettringite03_ss")
    push(aft.EndMember,"Tricarboalu03")
    if( get_var("Cement::Model::AFT_s_s$") = "s_s_nonideal") then
        aft.ideal = false
        aft.x1 = 0.45
        aft.x2 = 0.90
    endif    
    set(s_sModels,"aft",aft)
    
    #define AFm-SO4 AFm-OH model
    AFm = new(SolidSolutionModel)
    push(AFm.EndMember,"C4AH19")
    push(AFm.EndMember,"monosulphate16")
    AFm.ideal = false 
    AFm.x1 = 0.5
    AFm.x2 = 0.97   
    set(s_sModels,"AFm",AFm)
    
    #define AFm-SO4 AFm-Fe-SO4 model
    AFmFe = new(SolidSolutionModel)
    push(AFmFe.EndMember,"Fe-monosulphate")
    push(AFmFe.EndMember,"monosulphate16")
    AFmFe.ideal = false 
    AFmFe.x1 = 0.45
    AFmFe.x2 = 0.95 
    set(s_sModels,"AFmFe",AFmFe)
    
    #define HydrogarnetFe
    HydrogarnetFe = new(SolidSolutionModel)
    push(HydrogarnetFe.EndMember,"C3AFS0.84H4.32")
    push(HydrogarnetFe.EndMember,"C3FS0.84H4.32")
    set(s_sModels,"HydrogarnetFe",HydrogarnetFe)
    
    import "Define_New_Solid_Solution_CD.in"
    
    
    system = get_var("Cement::Model::System$") 
    system = left(system,2)
    number = string.strtoint(system)
    system = "sys"+system
    sysnr = new(CementModel)
    for i = 0 to get_defnrrec("CementSystem")-1
        columnindexstr =get_def("CementSystem","Nr",i)
        if(columnindexstr = number) then
            for j = 1 to get_defnrel("CementSystem",i)-1
                if(get_def("CementSystem",j,i) = 1) then
                   push(sysnr.Elements,get_defheading("CementSystem",j))
                endif 
            next j
        endif
    next i

    sysnr.CheckBulkdensity()
    sysnr.SetOxides()
    
    colindex = get_defheading("Phases_CD",system)
    minindex = get_defheading("Phases_CD","Mineral")
    for i = 0 to get_defnrrec("Phases_CD")-1
        if(get_def("Phases_CD",colindex,i)=1) then
            push(sysnr.PurePhases,get_def("Phases_CD",minindex,i))
        endif 
    next i
    
    colindex = get_defheading("SS_CD",system)

    for i = 0 to get_defnrrec("SS_CD")-1
        if(get_def("SS_CD",colindex,i)=1) then
                if (get_def("SS_CD",1,i) = "MSH") then
                        if (get_varexist("Cement::Model::MSH$")=0) then
                            if( get_var("Cement::Model::MSH$") = "s_s_no") then
                                push(sysnr.PurePhases,"M075SH")
                                push(sysnr.PurePhases,"M15SH")
                            else
                            set(sysnr.SolidSolution,"MSH",msh)
                            endif 
                        elseif
                            set(sysnr.SolidSolution,"MSH",msh)
                        endif                                    
                elseif (get_def("SS_CD",1,i) = "AFT") then
                        if (get_varexist("Cement::Model::AFT_s_s$")=0) then
                            if( get_var("Cement::Model::AFT_s_s$") = "s_s_no") then
                                push(sysnr.PurePhases,"Ettringite")
                                push(sysnr.PurePhases,"Tricarboalu03")
                            else
                                set(sysnr.SolidSolution,"AFT",aft)
                            endif 
                        elseif
                             set(sysnr.SolidSolution,"AFT",aft)
                        endif                     
                else
                    sprinta = get_def("SS_CD",1,i)
                    sprintb = get_def("SS_CD",0,i)
                    #set(sysnr.SolidSolution,get_def("SS_CD",1,i),get(s_sModels,get_def("SS_CD",0,i)))
                    set(sysnr.SolidSolution,sprinta,get(s_sModels,get_def("SS_CD",0,i)))
                endif
        endif 
    
    next i
    
    if (get_varexist("Cement::Model::Zeolites::Na") = 0) then
          if (get_var("Cement::Model::Zeolites::Na") = 1) then
           for zeo in ZeolitesNa
                push(sysnr.PurePhases,zeo)
            next
          endif
    endif
    if (get_varexist("Cement::Model::Zeolites::K") = 0) then
          if (get_var("Cement::Model::Zeolites::K") = 1) then
            for zeo in ZeolitesK
                push(sysnr.PurePhases,zeo)
            next
          endif
    endif
    if (get_varexist("Cement::Model::Zeolites::Ca") = 0) then
        if (get_var("Cement::Model::Zeolites::Ca") = 1) then
            for zeo in ZeolitesCa
             push(sysnr.PurePhases,zeo)
            next
          endif
    endif
    CementModels = dict(number,sysnr)

    endclass 
