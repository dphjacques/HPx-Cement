CALCULATE_VALUES
CementFunctionsRead
-state definition
-mybasic
-start 
    if(get_varexist("_ReadCementModels") = 0) then
        txt = " "
    else
        txt = "INCLUDE$ ModuleCement_Functions.hpi"
    endif
    put_var("_readcementmodel$",txt)
-end

@_readcementmodel$

CALCULATE_VALUES
CementHydrationInitiate
-mybasic
-state definition
-start
    import "ModuleCement_ModelSystems_02_CD.hps"
    import "ModuleCement_PhreeqcInput_20_Hydration_01_hydration.hps"
    
    import "ModuleCement_PhreeqcInput_20_Hydration_20_SCM_00_General.hps"

    if(get_varexist("Transport::SolutionNr") = 0) then
        entitynr = get_var("Transport::SolutionNr") 
    else
        entitynr = 1001
    endif
    if(get_varexist("Transport::Leaching::Hydration") = 0 ) then
        put_var("Hydration::OutputNr",100001)
    else
    put_var("Hydration::OutputNr",1)
        endif
    
    if(get_varexist("FA::Amount")>-1) then
      if(get_var("FA::Amount")>0) then
          bFA = 1
      endif
    endif
  
    system = get_var("Cement::Model::System$") 
    system = left(system,2)
    systemnr = string.strtoint(system)
    cemmodel = new(CementModelSystem)
    cemsys = cemmodel.GetCementModel(systemnr)
    cemmodel.CreateHeadings(systemnr)
  
    opckin = new(HydrationOPCmPK)
    if(bFA = 1) then         
            fakin = new(HydrationSCM)
            fakin.SCM = "FA"
            fakin.Model = get_var("Cement::Hydration::FA::Model$")
            fakin.RunType = get_var("Cement::Hydration::FA::Type$")
    endif
  
    
    put_var("Cement::_hydration",1)
    clear_def("Db_Kinetics")
    put_var("_timestep",0)
    put_var("Cement::Figures::Lead$","time")
    put_var("Cement::Figures::X::Title$","Time [d]")
    
  
    #rates
    ostr = opckin.WriteIncludeRates() + eol + "END" + eol 
    if (bFA=1) then
        ostr = ostr + "INCLUDE$ " + "Reaction_FA._in" + eol
        ostr = ostr + fakin.WriteIncludeRates(cemsys) + eol + "END" + eol 
    endif
    

    
    ostr = ostr + cemsys.WritePhreeqcSolution(entitynr,false,false,0)
    ostr = ostr + "USE SOLUTION " + str(entitynr) + eol
    ostr = ostr + "INCLUDE$ CementModel" + str(entitynr) + "._in" + eol
    openf("CementModel"+str(entitynr)+"._in")
    writef(cemsys.WritePhreeqcCementModel(entitynr,false,true))
    closef() 
    #React water with equilibruim constituents
    ostr = ostr + opckin.WriteEquilibriumReaction()
    ostr = ostr + "save solution " + str(entitynr) + eol
    ostr = ostr + "save equilibrium_phases " + str(entitynr) + eol
    ostr = ostr + "save solid_solutions " + str(entitynr) + eol
    ostr = ostr + "END " + eol
  
    ostr = ostr + "use solution " + str(entitynr) + eol
    ostr = ostr + "use equilibrium_phases " + str(entitynr) + eol
    ostr = ostr + "use solid_solutions " + str(entitynr) + eol
    ostr = ostr + "Kinetics " + str(entitynr) +  eol
    ostr = ostr + opckin.WriteKinetics(cemsys) + eol
    
    if (bFA=1) then
        ostr = ostr + fakin.WriteKinetics(cemsys) + eol  
    endif    
    
    ostr = ostr + opckin.WriteKineticSteps()
    
    #save options 
    ostr = ostr + "save SOLUTION " + str(entitynr) + eol
    ostr = ostr + "save EQUILIBRIUM_PHASES " + str(entitynr) + eol
    ostr = ostr + "save SOLID_SOLUTIONS " + str(entitynr) + eol
     
    txt = "use SOLUTION " + str(entitynr) + eol
    txt = txt + "use EQUILIBRIUM_PHASES " + str(entitynr) + eol
    txt = txt + "use SOLID_SOLUTIONS " + str(entitynr) + eol
    put_var("Cement::Identity::_LastSaved$",txt)
    
    txt = "use EQUILIBRIUM_PHASES " + str(entitynr) + eol
    txt = txt + "use SOLID_SOLUTIONS " + str(entitynr) + eol
    txt = txt + "save EQUILIBRIUM_PHASES " + str(entitynr) + eol
    txt = txt + "save SOLID_SOLUTIONS " + str(entitynr) + eol
    put_var("Cement::Identity::_LastSavedUsed$",txt)
        
    openf("Hydration._in")
    writef(ostr)
    closef() 
    
    db = "Db_Kinetics"
    count = get_defnrrec(db)-1
    htxt = ""
    hvtxt = ""
    hwtxt = ""
    hhtxt = ""
    hdtxt = ""
    for i = 0 to count 
       htxt = htxt + get_def(db,"kin",i) + " "
       hvtxt = hvtxt + "v" + get_def(db,"kin",i) + " "
       hwtxt = hwtxt + "w" + get_def(db,"kin",i) + " "
       hhtxt = hhtxt + "h" + get_def(db,"kin",i) + " "
       if(get_varexist("Cement::Output::Hydrates::CumHeat") = 0 ) then
           if(get_var("Cement::Output::Hydrates::CumHeat") = 1 ) then
            hhtxt  = hhtxt + "ch" + get_def(db,"kin",i) + " "
           endif
       endif  
        if(get_varexist("Cement::Output::Hydration::HydrationDegree") = 0 ) then
            if(get_var("Cement::Output::Hydration::HydrationDegree") = 1 ) then
                hdtxt = hdtxt + "hd" + get_def(db,"kin",i) + " "
            endif
    endif      
    next i
    put_var("Output::Kinetics",htxt)
    put_var("Output::Kineticsv",hvtxt)
    put_var("Output::Kineticsw",hwtxt)    
    if(get_varexist("Cement::Output::Hydrates::Heat") = 0 ) then
         if(get_var("Cement::Output::Hydrates::Heat") = 1 ) then
             put_var("Output::HeatKin",hhtxt)
         endif
    endif
    
    if(get_varexist("Cement::Output::Hydration::HydrationDegree") = 0 ) then
         if(get_var("Cement::Output::Hydration::HydrationDegree") = 1 ) then
             put_var("Output::HydrationDegree",hdtxt + "hdTotal")
         endif
    endif
    
    vol = get_var("Cement::Composition::Clinker::Volume0")
    
    if(get_varexist("Cement::Figures::Time::hour")<0) then
        put_var("Cement::Figures::Time::hour",1)
    endif 
    if(get_varexist("Cement::Figures::Time::Second")<0) then
        put_var("Cement::Figures::Time::Second",1)
    endif 

-end

#output
selected_output @Hydration::OutputNr
-file CementHydrationResults.out
-reset false
-active true 

INCLUDE$ ModuleCement_UserPunch.hps

#Mulitple

INCLUDE$ Hydration._in
end