
calculate_values
CalculateHydrationDegreeTotal
#Calculation of hydration degree
-mybasic
-start
    total = kin("HydrationRateAlite") + kin("HydrationRateBelite") + kin("HydrationRateAluminate") + kin("HydrationRateFerrite")
    w0 = get_var("Cement::Composition::Clinker::Moles0")
    hydrationdegree = (w0-total)/w0
    save(hydrationdegree)
-end 
CalculateHydrationDegree
#Calculation of hydration degree
-mybasic
-start
'[
Parameters:
1   m0 
2   m
']
    hydrationdegree = (calc_arg(1)-calc_arg(2))/calc_arg(1)
    save(hydrationdegree)
-end
RateHydrationParrotKillohNucleation
#Calculation of rate 1 : rate following Nucleation and Growth
-mybasic
-start
# 1 hydrationdegree
# 2 K1 
# 3 N1 
    hd = calc_arg(1)
    rate = (calc_arg(2)/calc_arg(3))*(1-hd)
    if(hd<1E-10) then
    rate=rate*(-log(1E-10))^(1-calc_arg(3))
    else
    rate = rate*(-log(1-hd))^(1-calc_arg(3))
    endif
    save(rate)
-end
RateHydrationParrotKillohDiffusion
#Calculation of rate 2 : rate following Diffusion
-mybasic
-start
# 1 hydrationdegree
# 2 K2 
    hd=calc_arg(1)
    rate = calc_arg(2)*(1-hd)^(2/3)
    rate = rate / (1-(1-hd)^(1/3))
    save(rate)
    'writes("diff " + str(rate))
-end
RateHydrationParrotKillohShellFormation
#Calculation of rate 3 : rate following Shell formation
-mybasic
-start
# 1 hydrationdegree
# 2 K3 
# 3 N3
    hd = calc_arg(1)
    rate = calc_arg(2)*(1-hd)^(calc_arg(3))
    save(rate)
    'writes("shell " + str(rate))
-end
RateHydrationParrotKillohWaterCement
#Calculation of the influence of w/c on the hydration rate
-mybasic
-start
# 1 hydrationdegree
# 2 Hx
# 3 w/c
    hd = calc_arg(1)
    value = calc_arg(2)*calc_arg(3)
    if hd<value then 
        factor = 1
    else
      factor = (1+3.333*(value-hd))^4
    endif
    save(factor)
    'writes("fac " + str(factor))
-end
RateHydrationParrotKillohTemperature
-mybasic 
-start 
 if(calc_arg(1) < 0 ) then
    save(1)
 else
     tsample = tk()
     tref = calc_arg(2) + 273.15
     sl = calc_arg(1) / 8.314
     dif = (1/tsample - 1/tref)
     dif = sl*dif
     dif = exp(dif)
     save(1/dif)
 endif
-end 


RATES
OPCAlite
-mybasic 
-start 
# Parameters
# 1 AliteK1 1.5
# 2 AliteN1 0.7
# 3 AliteK2 0.05
# 4 AliteK3 1.1
# 5 AliteN3 3.3
# 6 Hx
# 7 EA
# 8 EAT
# 9 w/c

#calculation of parameters for all clinkers
    hda = calc_value("CalculateHydrationDegreeTotal")
    hd  = calc_value("CalculateHydrationDegree",m0(),m())
    
#calculation minimal rate
    rate1 = calc_value("RateHydrationParrotKillohNucleation",hd,parm(1),parm(2))
    rate2 = calc_value("RateHydrationParrotKillohDiffusion",hd,parm(3))
    rate3 = calc_value("RateHydrationParrotKillohShellFormation",hd,parm(4),parm(5))
    area = 1
    rate1 = rate1*area
    if rate1<rate2 then 
       rate=rate1 
    else
       rate=rate2
    endif
    if rate3<rate then 
       rate=rate3
    endif
#Rate Limiting Factors
#w/c dependency
#RH (not implemented)
#Area
#Temperature (not implemented)
    wc = calc_value("RateHydrationParrotKillohWaterCement",hda,parm(6),parm(9))
    rh = 1
    tem = calc_value("RateHydrationParrotKillohTemperature",parm(7),parm(8))
#Rate and mass
    rate = rate*wc*rh*tem
    dhd = rate*time()
    moles = m0()*dhd
    save(moles)
    #997 put(rate1*wc,101)
    #998 put(wc,102)
    #999 put(hd,103)
-end

