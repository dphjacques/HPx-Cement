include$ ModuleCement_PhreeqcInput_20_Hydration_00_general_01_mPK.hps

calculate_values
CalculateHydrationDegreeTotalOPC
#Calculation of hydration degree
-mybasic
-start
    total = kin("OPCAlite")*228 + kin("OPCBelite")*172 + kin("OPCFerrite")*645.2 + kin("OPCAluminate")*269.96
    w0 = get_var("Cement::Composition::Clinker::Weight0")
	if(w0 > 0) then
		hydrationdegree = (w0-total)/w0
	else
		hydrationdegree = 0
	endif
    save(hydrationdegree)
-end 

RATES
OPCAlite
-mybasic 
-start 
# Parameters
# 1 AliteK1 1.5
# 2 AliteN1 0.7
# 3 AliteK2 0.05
# 4 AliteK3 1.1
# 5 AliteN3 3.3
# 6 Hx
# 7 EA
# 8 EAT
# 9 w/c

#calculation degree of hydration of parameters for all clinkers
    hd  = calc_value("CalculateHydrationDegree",m0(),m()) #used in mpK rates 	
    import "ModuleCement_PhreeqcInput_20_Hydration_00_general_01_mPK_00_rate.hps"
	
-end

