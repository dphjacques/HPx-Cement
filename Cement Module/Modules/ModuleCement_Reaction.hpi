class CementModel

    var Elements = list()
    var PurePhases = list()
    var SolidSolution = dict()
    var Oxides = list()
    
    def SetOxides()
        if(exists(Elements,"Ca")) then push(Oxides,"CaO")
        if(exists(Elements,"Si")) then push(Oxides,"SiO2")
        if(exists(Elements,"Al")) then push(Oxides,"Al2O3")
        if(exists(Elements,"S")) then push(Oxides,"SO3")
        if(exists(Elements,"Mg")) then push(Oxides,"MgO")
        if(exists(Elements,"C")) then push(Oxides,"CO2")
        if(exists(Elements,"Fe")) then push(Oxides,"Fe2O3")
        if(exists(Elements,"Na")) then push(Oxides,"Na2O")
        if(exists(Elements,"K")) then push(Oxides,"K2O")
        if(exists(Elements,"N")) then push(Oxides,"NO2")              
    enddef
    
    def CheckBulkdensity()
        if(get_varexist("Cement::Clinker::BulkDensity") <> 0) then
            rowlabel = get_var("Cement::Clinker::Reference$")
            if(get_defexist("OPC","BulkDensity",rowlabel) = 0) then
                put_var("Cement::Clinker::BulkDensity",get_def("OPC","BulkDensity",rowlabel)))
            else
                put_var("Cement::Clinker::BulkDensity",-1)
            endif
        endif
        if(get_varexist("GBFS::BulkDensity") <> 0) then
			if( get_varexist("GBFS::Reference$") = 0 ) then
				rowlabel = get_var("GBFS::Reference$")
				if(get_defexist("GBFS","BulkDensity",rowlabel) = 0) then
					put_var("GBFS::BulkDensity",get_def("GBFS","BulkDensity",rowlabel)))
				else
					put_var("GBFS::BulkDensity",-1)
				endif
			else
					put_var("GBFS::BulkDensity",-1)			
			endif
        endif		
        if(get_varexist("SF::BulkDensity") <> 0) then
			if( get_varexist("SF::Reference$") = 0) then
				rowlabel = get_var("SF::Reference$")
				if(get_defexist("SF","BulkDensity",rowlabel) = 0) then
					put_var("SF::BulkDensity",get_def("SF","BulkDensity",rowlabel)))
				else
					put_var("SF::BulkDensity",-1)
				endif
			else
				put_var("SF::BulkDensity",-1)
			endif
        endif		
        if(get_varexist("FA::BulkDensity") <> 0) then
			if( get_varexist("FA::Reference$") = 0 ) then
				rowlabel = get_var("FA::Reference$")
				if(get_defexist("FA","BulkDensity",rowlabel) = 0) then
					put_var("FA::BulkDensity",get_def("FA","BulkDensity",rowlabel)))
				else
					put_var("FA::BulkDensity",-1)
				endif
			else
				put_var("FA::BulkDensity",-1)
			endif
        endif
        if(get_varexist("LS::BulkDensity") <> 0) then
			if( get_varexist("LS::Reference$") = 0 ) then
				rowlabel = get_var("LS::Reference$")
				if(get_defexist("LS","BulkDensity",rowlabel) = 0) then
					put_var("LS::BulkDensity",get_def("LS","BulkDensity",rowlabel)))
				else
					put_var("LS::BulkDensity",-1)
				endif
			else
				put_var("LS::BulkDensity",-1)
			endif
        endif
        if(get_varexist("MK::BulkDensity") <> 0) then
			if( get_varexist("MK::Reference$")=0) then
				rowlabel = get_var("MK::Reference$")
				if(get_defexist("MK","BulkDensity",rowlabel) = 0) then
					put_var("MK::BulkDensity",get_def("MK","BulkDensity",rowlabel)))
				else
					put_var("MK::BulkDensity",-1)
				endif
			else
				put_var("MK::BulkDensity",-1)
			endif
        endif
    enddef
    
    def WritePhreeqcSolution(entitynr,boutprint, boutpunch,belement)
		belement = 1
        txt = "SOLUTION " + str(entitynr) + eol
        amountwater = get_Var("Cement::Recipe::Amount")*get_var("Cement::Recipe::w_c")/1000
        put_var("AmountWater",amountwater)
        txt= txt + "-water " + str(amountwater) + eol
        txt = txt + "-temperature " + str(get_var("Cement::Recipe::T")) + eol)
        if(belement = 1) then 
            db = "Db_Elements"
            count = get_defnrrec(db)-1
            for i = 0 to count 
                txt = txt + get_def(db,i) + " 1E-12 " + eol
            next i  
        endif
        txt = txt + "PRINT "+ eol + "-reset   "
        if(boutprint = 0) then 
           txt = txt + "false" + eol 
        else 
           txt = txt + "true" + eol
		   txt = txt + "-echo_input false" + eol
        endif
        txt = txt + "SELECTED_OUTPUT "+ eol + "-active " 
        if(boutpunch = 0) then 
           txt = txt + "false" + eol 
        else 
           txt = txt + "true" + eol
		   txt = txt + "-echo_input false" + eol
        endif
        txt = txt + "END" + eol

        return txt
    enddef 
    
    def WritePhreeqcCementModel(entitynr,boutprint, boutpunch)
        txt = ""
        
        txt = txt + "EQUILIBRIUM_PHASES " + str(entitynr) + eol
        changedmodel = 0
        if(get_varexist("_ChangedModel") = 0 ) then
            changedmodel = get_var("_ChangedModel")
        endif
        if(changedmodel>0) then
            db = get_var("Cement::Model::AdaptedModel$")
        endif
        for min in PurePhases
            'first check if it should be excluded in the variant model
            if(changedmodel>0) then
                
            else
                txt = txt + min + " 0 0 " + eol
            endif
        next      
        if(len(SolidSolution)>0) then
            txt = txt + "SOLID_SOLUTIONS " + str(entitynr) + eol
            for ss in SolidSolution
                txt = txt + ss + eol
                ssmodel = SolidSolution(ss)
                txt = txt + ssmodel.WritePhreeqcSolidSolution()
            next
        endif
        
        txt = txt + "PRINT "+ eol + "-reset " 
        if(boutprint = 0) then 
           txt = txt + "false" + eol 
        else 
           txt = txt + "true" + eol
        endif
        txt = txt + "SELECTED_OUTPUT "+ eol + "-active " 
        if(boutpunch = 0) then 
           txt = txt + "false" + eol 
        else 
           txt = txt + "true" + eol
        endif
        return txt
    enddef
	
	import "ModuleCement_Reactivity.hpi"
    
    def WritePhreeqcCementReaction(entitynr)


        #Set System
        #b... if constituent is present
        #r... Reactivity model - -1:Full -2:Bulk -3:Oxide-specific
        bopc = 0
        bgbfs = 0
        rgbfs = -1
        bsf = 0
        rsf = -1
        bfa = 0
        rfa = -1
        bls = 0
        rls = -1
        bmk = 0
        rmk = -1
        
        

        if( get_varexist("Cement::Clinker::Amount") = 0 ) then
            if(  get_var("Cement::Clinker::Amount") > 0) then
                bopc = 1
            endif
        endif
        if( get_varexist("GBFS::Amount") = 0 ) then
            if(  get_var("GBFS::Amount") > 0) then
                bgbfs = 1
                if(get_varexist("GBFS::Reactivity$") = 0) then
                     rgbfs = Reactivity(get_var("GBFS::Reactivity$"))
                endif
            endif
        endif
        if( get_varexist("SF::Amount") = 0 ) then
            if(  get_var("SF::Amount") > 0) then
                bsf = 1
                if(get_varexist("SF::Reactivity$") = 0) then
                    rsf = Reactivity(get_var("SF::Reactivity$"))
                endif
            endif
        endif
        if( get_varexist("FA::Amount") = 0 ) then
            if(  get_var("FA::Amount") > 0) then
                bfa = 1
                if(get_varexist("FA::Reactivity$") = 0) then
                    rfa = Reactivity(get_var("FA::Reactivity$"))
                endif
            endif
        endif
        if( get_varexist("LS::Amount") = 0 ) then
            if(  get_var("LS::Amount") > 0) then
                bls = 1
                if(get_varexist("LS::Reactivity$") = 0) then
                    rls = Reactivity(get_var("LS::Reactivity$"))
                endif
            endif
        endif
        if( get_varexist("MK::Amount") = 0 ) then
            if(  get_var("MK::Amount") > 0) then
                bmk = 1
                if(get_varexist("MK::Reactivity$") = 0) then
                    rmk = Reactivity(get_var("MK::Reactivity$"))
                endif
            endif
        endif


        #relative amounts of oxide Cement
        if(bopc = 1) then
            rowlabelcement =  get_var("Cement::Clinker::Reference$") 
        endif
        if(bgbfs=1) then
            rowlabelgbfs = get_var("GBFS::Reference$")
            rgbfs = ReactivityValueTot(rgbfs,"GBFS",rowlabel)
        endif
        if(bsf=1) then
            rowlabelsf = get_var("SF::Reference$")
            rsf = ReactivityValueTot(rsf,"SF",rowlabelsf)
        endif
        if(bfa=1) then
            rowlabelfa = get_var("FA::Reference$")
            rfa = ReactivityValueTot(rfa,"FA",rowlabelfa)
            write("FA reactivity res " + str(rfa) + eol)
        endif
        if(bls=1) then
            rowlabells = get_var("LS::Reference$")
            ls = ReactivityValueTot(rls,"LS",rowlabells)
        endif
        if(bmk=1) then
            rowlabelmk = get_var("MK::Reference$")
            rmk = ReactivityValueTot(rmk,"MK",rowlabelmk)
        endif

        #
        txt = "REACTION " + str(entitynr) + eol 
        it = iterator(Oxides)
        while move_next(it) 
            oxide = get(it)
            txt = txt + oxide + " " 
            amt = 0
            amR = 0
            am = 0
            if(bopc = 1) then
                if(get_defexist("OPC",oxide,rowlabelcement)=0) then
                    amopc = get_def("OPC",oxide,rowlabelcement)* get_var("Cement::Clinker::Amount") /100 
                    amt = amt + amopc
                    amopc =amopc * get_var("Cement::Clinker::ReactedAmount") /100 
                    amR = amR + amopc
                    am = am +  amopc
                endif
            endif
            if(bgbfs = 1) then
                if(get_defexist("GBFS",oxide,rowlabelgbfs)=0) then
                    amgbfs = get_def("GBFS",oxide,rowlabelgbfs)*  get_var("GBFS::Amount")  /100 
                    amt = amt + amgbfs
                    amgbfs= amgbfs*get_var("GBFS::ReactedAmount") /100 
                    amR = amR + amgbfs
                    amgbfs = amgbfs*ReactivityValueTotOx(rgbfs,"GBFS",rowlabelgbfs,oxide)
                    am = am + amgbfs
                endif
            endif
            if(bsf = 1) then
                if(get_defexist("SF",oxide,rowlabelsf)=0) then
                    amsf = get_def("SF",oxide,rowlabelsf)*  get_var("SF::Amount")  /100 
                    amt = amt + amsf
                    afsf = amsf * get_var("SF::ReactedAmount") /100
                    amR = amR + amsf
                    amsf = amsf*ReactivityValueTotOx(rsf,"SF",rowlabelsf,oxide) 
                    am = am + amsf
                endif
            endif
            if(bfa = 1) then
                if(get_defexist("FA",oxide,rowlabelfa)=0) then
                    amfa = get_def("FA",oxide,rowlabelfa)*  get_var("FA::Amount")  /100
                    amt = amt + amfa
                    amfa = amfa*  get_var("FA::ReactedAmount") /100 
                    amR = amR + amfa
                    write("FA oxide " + str(ReactivityValueTotOx(rfa,"FA",rowlabelfa,oxide)) + eol)
                    amfa = amfa*ReactivityValueTotOx(rfa,"FA",rowlabelfa,oxide)
                    am = am + amfa 
                endif
            endif
            if(bls = 1) then
                if(get_defexist("LS",oxide,rowlabells)=0) then
                    amls = get_def("LS",oxide,rowlabells)*  get_var("LS::Amount")  /100 
                    amt = amt + amls
                    amls = amls *  get_var("LS::ReactedAmount") /100
                    amR = amR + amls
                    amls = amls*ReactivityValueTotOx(rls,"LS",rowlabells,oxide) 
                    am = am + amls
                endif
            endif
            if(bmk = 1) then
                if(get_defexist("MK",oxide,rowlabelmk)=0) then
                    ammk = get_def("MK",oxide,rowlabelmk)*  get_var("MK::Amount")  /100 
                    amt = amt + ammk
                    ammk = ammk *  get_var("MK::ReactedAmount") /100
                    amR = amR + ammk
                    ammk = ammk*ReactivityValueTotOx(rmk,"MK",rowlabelmk,oxide)
                    am = am + ammk
                endif
            endif
            am = am /gfw(oxide)
            txt = txt + str(am) + eol
            put_var("Cement::Recipe::"+oxide+"::Total",amt*get_var("Cement::Recipe::Amount") /100/gfw(oxide))
            put_var("Cement::Recipe::"+oxide+"::Hydrated",amR*get_var("Cement::Recipe::Amount") /100/gfw(oxide))
            put_var("Cement::Recipe::"+oxide,am*get_var("Cement::Recipe::Amount") /100)
        wend        
        txt = txt + str(get_var("Cement::Recipe::Amount") /100) #+ " in 10 steps" 

        return txt
    enddef


    
    
endclass
