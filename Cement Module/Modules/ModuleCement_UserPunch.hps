INCLUDE$ ModuleCement_UserPunch_Generic.hps
INCLUDE$ ModuleCement_UserPunch_userpunch.hps

INCLUDE$ ModuleCementFigures/00_Definitions_02_LineStyleNumbers.hpi

CALCULATE_VALUES
ExtrOutputPunch
-state Definition
-mybasic
-start 
    if(get_varexist("Cement::Leaching") = 0 ) then
        cementleaching = get_var("Cement::Leaching")
    endif
    txt = ""
    fignr = 1
    belements = 0
    belements_mg = 0
    bsolids = 0
    bsolidvol = 0
    bsolidgram = 0
    bsolid100 = 0
    convert =  get_var("Cement::Recipe::Amount") /100
    convertstr = " t " + chr(34) + "_THIS/" + str(convert) + chr(34) + " " 
    TextFigureGroup = "DefaultGraphs"
      
    import "ModuleCement_UserPunch_usergraphs_List.hps"
    import "ModuleCement_UserPunch_usergraphs_Figures.hps"  
    import "ModuleCement_UserPunch_usergraphs_Ternary.hps"     

    bhyd = 1
    if(get_varexist("Cement::_hydration")=0) then 
       if(get_var("Cement::_hydration") = 1) then
           bhyd= 0
           TextFigureGroup = "Hydration"
       endif 
    endif
    if(bhyd = 1) then
       if(get_varexist("Cement::Leaching::Type$") = 0 ) then
           TextFigureGroup = "Leaching"    
       endif
    endif  
    
    figures = false  
    figures1 = false
    if( get_varexist("Cement::Figures") = 0 ) then 
        if( get_var("Cement::Figures") = 1 ) then
            figures = true
            figures1 = true
        endif
    endif  
    if( get_varexist("Transport::Hydration::Figures") = 0 ) then 
        if( get_var("Transport::Hydration::Figures") = 1 ) then
            figures = true
            figures1 = true
        endif
    endif
    if( get_varexist("Cement::Figures::Ternary") = 0 ) then
        if( get_var("Cement::Figures::Ternary") = 1 ) then
            figures = true
        endif
    endif
    if(figures) then
            dir = get_var("_Managed$") + "12_modules/ModuleCementFigures"
            txt = txt + "INCLUDEPATH " +  dir + eol
            dir = dir + "\"
            txt = txt + "SELECTED_GRAPH " + str(get_var("Hydration::OutputNr")) + eol 
            txt = txt + "-include " + dir + "00_Definitions_01_colors.plt"  + eol
    endif
        
    if( figures1) then
        txt = txt + "-start " + eol
        if (get_varexist("Cement::Figures::X::Reverse") = 0 ) then
        if (get_var("Cement::Figures::X::Reverse") = 1 ) then
         txt = txt + " set xrange reverse " + eol
        endif
        endif
        txt = txt + "-end " + eol
        
        WriteFigures()
    endif
  
  
    if( get_varexist("Cement::Figures::Ternary") = 0 ) then
       if( get_var("Cement::Figures::Ternary") = 1 ) then
            txt = txt + "-start" + eol
            txt = txt + "set palette maxcolors 10" +eol
            txt = txt + "set palette model RGB" +eol
            txt = txt + "set palette defined (0 " + chr(34) + "web-blue" + chr(34) + " , 0.25 " + chr(34) + "light-blue" + chr(34) + ", 0.5 " + chr(34) + "web-green" + chr(34) + ", 0.75 " + chr(34) + "yellow" + chr(34) + " , 1.0 " + chr(34) + "red" + chr(34) + ")" +eol
            txt = txt + "-end" + eol
            WriteTernaryFigures()
         endif
     endif
     
     
     
     graphname = "_graphs" + TextFigureGroup + "._in"
     openf(graphname)
     writef(txt)
     closef()
     put_var("_graphs_in$",graphname)

-end


include$ @_graphs_in$

