CALCULATE_VALUES
ExtrOutputPunch
-state Definition
-mybasic
-start 
    txt = ""
    ktxt = ""
    if( get_varexist("Cement::Output::Hydrates::Moles") > -1 ) then
        if( get_var("Cement::Output::Hydrates::Moles") = 1 ) then
            txt = txt + "-headings " + get_var("Output::Phases") + eol
            txt = txt + "-headings " + get_var("Output::SolidSolutions") + eol
            txt = txt + "-headings " + get_var("Output::SolidSolutionsComp") + eol
            if(get_varexist("Output::Kinetics") > -1 ) then
                ktxt = ktxt + get_var("Output::Kinetics") + " "
            endif   
        endif 
    else
        put_var("Cement::Output::Hydrates::Moles",0)
    endif
    if(  get_varexist("Cement::Output::Hydrates::Volumes") > -1 ) then
        if(  get_var("Cement::Output::Hydrates::Volumes")  = 1 ) then
            txt = txt + "-headings " + get_var("Output::Phasesv") + eol
            txt = txt + "-headings " + get_var("Output::SolidSolutionsv") + eol
            txt = txt + "-headings " + get_var("Output::SolidSolutionsCompv") + eol
            if(get_varexist("Output::Kineticsv") > -1 ) then
                ktxt = ktxt + get_var("Output::Kineticsv") + " "
            endif  
        endif 
    else
        put_var("Cement::Output::Hydrates::Volumes",0)
    endif 
    if( get_varexist("Cement::Output::Hydrates::Weights") > -1 ) then
        if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
            txt = txt + "-headings " + get_var("Output::Phasesw") + eol
            txt = txt + "-headings " + get_var("Output::SolidSolutionsw") + eol
            txt = txt + "-headings " + get_var("Output::SolidSolutionsCompw") + eol
            if(get_varexist("Output::Kineticsw") > -1 ) then
                ktxt = ktxt + get_var("Output::Kineticsw") + " "
            endif  
        endif 
    else
        put_var("Cement::Output::Hydrates::Weights",0) 
    endif
    if( get_varexist("Cement::Output::Hydrates::SaturationIndex") > -1 ) then
        if(get_var("Cement::Output::Hydrates::SaturationIndex")  = 1 ) then
            txt = txt + "-headings" + get_var("Output::Phasessi")
        endif 
    else
        put_var("Cement::Output::Hydrates::SaturationIndex",0) 
    endif
    openf("_txtheading._in")
    writef(txt)
    closef()
    put_var("_leadnr",0)
    
    put_var("Output::Kineticsh",ktxt)
    
-end 

USER_PUNCH 
-mybasic
-headings Amount OPC GBFS SF FA LS wc
-headings @Output::Oxides 

-headings Lead
-headings water T pH mu
-headings @Output::Elements
include$ _txtheading._in
-headings CSH_Ca CSH_Si GelPores
-headings @Output::Zeolites
-headings @Output::Kineticsh

-start
 
    punch(  get_var("Cement::Recipe::Amount") )
    punch( get_var("Cement::Clinker::Amount") )
    if(get_varexist("GBFS::Amount") > -1) then
        punch( get_var("GBFS::Amount") )
    else
        punch(0)
    endif 
        if(get_varexist("SF::Amount") > -1) then
        punch( get_var("SF::Amount") )
    else
        punch(0)
    endif 
        if(get_varexist("FA::Amount") > -1) then
        punch( get_var("FA::Amount") )
    else
        punch(0)
    endif 
        if(get_varexist("LS::Amount") > -1) then
        punch( get_var("LS::Amount") )
    else
        punch(0)
    endif 
    punch( get_var("Cement::Recipe::w_c") )
    
    #print oxides
    db = "Db_Elements"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        ox=get_def(db,i)
        am = sys(ox)
        if(ox="Al") then am=am/2 endif
        if(ox="Fe") then am=am/2 endif
        if(ox="Na") then am=am/2 endif
        if(ox="K") then am=am/2 endif
        
        punch(am)
    next i 
    
    #print lead
    if(get_varexist("Cement::Leaching::Type$") = 0 ) then
        if(get_varexist("Leaching::Run::AddedWater")=0) then
            addedwater = get_var("Leaching::Run::TotalAmountAddedWater") + get_var("Leaching::Run::AddedWater")
            punch(addedwater))
            put_var("Leaching::Run::TotalAmountAddedWater",addedwater )
        else
          punch(0)
        endif
    elseif (get_varexist("Cement::Ingress::Type$") = 0 ) then
        _step = sys("[_step]")
        if ( get_var("Cement::Figures::Lead$") <> "null" ) then
            leadvar = get_var("Cement::Figures::Lead$")
            if(get_varexist(leadvar) = 0) then
                punch( _step*get_var(leadvar))
            else
                punch( _step)
            endif
        else
            punch( _step)
        endif
        if(get_var("Cement::Ingress::Type$") = "Components" ) then
            if(get_Var("Cement::Ingress::Components::Type$" )  = "Relative Moles" ) then
                #punch( _step*get_var("Cement::Ingress::Components::CO2")) 
                #punch( _step*get_var("Cement::Ingress::Components::SO3")) 
                #punch( _step*get_var("Cement::Ingress::Components::MgCl2")) 
                #punch( _step*get_var("Cement::Ingress::Components::NaCl")) 
            endif
        endif
    elseif ( get_var("Cement::Figures::Lead$") <> "null" ) then
        leadvar = get_var("Cement::Figures::Lead$")
        if(string.comparenocase(leadvar,"time") = 0) then
            punch(total_time())
        elseif(get_varexist(leadvar) = 0) then
            punch(get_var(leadvar))
        else
            punch(get_var("_leadnr"))
            put_var("_leadnr",get_var("_leadnr")+1)
        endif 
    else
        punch(get_var("_leadnr"))
        put_var("_leadnr",get_var("_leadnr")+1) 
    endif 
    
    punch(tot("water"))
    punch(tc())
    punch(-la("H+"), mu())
    
    
    #print solution
    db = "Db_Elements"
    count = get_defnrrec(db)-1

    for i = 0 to count 
        punch(tot(get_def(db,i)))
    next i
    
    #print minerals & ss
    if( get_var("Cement::Output::Hydrates::Moles") = 1 ) then
        db = "Db_Minerals"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(equi(get_def(db,i)))
        next i
        db = "Db_SolidSolutions"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(s_s(get_def(db,i)))
        next i
        
        db = "Db_SolidSolutions_Def"
        dba = "Db_SolidSolutions_Comp"
        count = get_defnrrec(db)-1

        for i = 0 to count 
            min = get_def(db,0,i)
            nr = get_def(db,1,i)
            am= 0
            for j = 0 to nr-1
                am = am + s_s(get_def(dba,i,j))
            next j
            punch(am)
        next i      
        
    endif 
    if(  get_var("Cement::Output::Hydrates::Volumes")  = 1 ) then
        db = "Db_Minerals"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(equi(get_def(db,i))*phase_vm(get_def(db,i)))
        next i
        db = "Db_SolidSolutions"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(s_s(get_def(db,i))*phase_vm(get_def(db,i)))
        next i
        
        db = "Db_SolidSolutions_Def"
        dba = "Db_SolidSolutions_Comp"
        count = get_defnrrec(db)-1
                write("NRCOUNT" + str(count) + " " + eol)
        for i = 0 to count 
            min = get_def(db,0,i)
            nr = get_def(db,1,i)
            am= 0
            for j = 0 to nr-1
            am = am + s_s(get_def(dba,i,j))*phase_vm(get_def(dba,i,j))
            next j
            punch(am)
        next i 
    endif 
    if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
        db = "Db_Minerals"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            w= gfw(phase_formula(get_def(db,i)))
            punch(equi(get_def(db,i))*w)
        next i
        db = "Db_SolidSolutions"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            w= gfw(phase_formula(get_def(db,i)))
            punch(s_s(get_def(db,i))*w)
        next i
        
        db = "Db_SolidSolutions_Def"
        dba = "Db_SolidSolutions_Comp"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            min = get_def(db,0,i)
            nr = get_def(db,1,i)
            am= 0
            for j = 0 to nr-1
                w= gfw(phase_formula(get_def(dba,i,j)))
                am = am + s_s(get_def(dba,i,j))*w
            next j
            punch(am)
        next i 
    endif 
    
    
    #saturation Index
    if(get_varexist("Cement::Output::Hydrates::SaturationIndex") = 0 ) then
       if(get_var("Cement::Output::Hydrates::SaturationIndex") = 1 ) then   
           db = "Db_Minerals"
           count = get_defnrrec(db)-1
            for i = 0 to count 
                punch(si(get_def(db,i)))
            next i  
            #db = "Db_SolidSolutions"
            #count = get_defnrrec(db)-1
            #for i = 0 to count 
            #  punch(si(get_def(db,i)))
            #next i  
       endif
    endif
    
    
    ca = sum_s_s("CSH","Ca")
    sil = sum_s_s("CSH","Si")
    if(ca > 0 AND sil > 0) then
        punch(ca,sil)
        punch(calc_value("VolumeGelPores",ca,sil))
    else
        ca =1.6* equi("CSH1.6") + 1.2* equi("CSH1.2") +0.8* equi("CSH0.8")
        sil = equi("CSH1.6") + equi("CSH1.2") + equi("CSH0.8")
        punch(ca,sil)
        punch(0)
    endif
    
    #Zeolites
    #0 zeo 1 na 2 k 3 ca 4 si 5 al
    if (get_varexist("Cement::Model::Zeolites::Na") = 0) then
       if (get_var("Cement::Model::Zeolites::Na") = 1) then
           db = "Db_ZeolitesNa"
           count = get_defnrrec(db)-1
           nao = 0
           ko = 0
           cao = 0
           sio = 0
           alo = 0
           for i = 0 to count 
               am = equi(get_def(db,0,i))

               nao = nao + get_def(db,1,i)*am 
               ko =  ko  + get_def(db,2,i)*am 
               cao = cao + get_def(db,3,i)*am 
               sio = sio + get_def(db,4,i)*am 
               alo = alo + get_def(db,5,i)*am 
           next i
           punch(nao, sio, alo)
       endif
    endif
    if (get_varexist("Cement::Model::Zeolites::K") = 0) then
        if (get_var("Cement::Model::Zeolites::K") = 1) then
            db = "Db_ZeolitesK"
            count = get_defnrrec(db)-1
           nao = 0
           ko = 0
           cao = 0
           sio = 0
           alo = 0
           for i = 0 to count 
               am = equi(get_def(db,0,i))
               nao = nao + get_def(db,1,i)*am 
               ko =  ko  + get_def(db,2,i)*am 
               cao = cao + get_def(db,3,i)*am 
               sio = sio + get_def(db,4,i)*am 
               alo = alo + get_def(db,5,i)*am 
           next i
           punch(ko, sio, alo)
       endif
    endif
    if (get_varexist("Cement::Model::Zeolites::Ca") = 0) then
        if (get_var("Cement::Model::Zeolites::Ca") = 1) then
           db = "Db_ZeolitesCa"
           count = get_defnrrec(db)-1
           nao = 0
           ko = 0
           cao = 0
           sio = 0
           alo = 0
           for i = 0 to count  
               am = equi(get_def(db,0,i))
               nao = nao + get_def(db,1,i)*am 
               ko =  ko  + get_def(db,2,i)*am 
               cao = cao + get_def(db,3,i)*am 
               sio = sio + get_def(db,4,i)*am 
               alo = alo + get_def(db,5,i)*am 
           next i
           punch(cao, sio, alo)
       endif
    endif
    
    #Kinetics
    if (get_varexist("Cement::_hydration") = 0) then
        db = "Db_Kinetics"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(kin(get_def(db,"kin",i)))
        next i
        if(  get_var("Cement::Output::Hydrates::Volumes")  = 1 ) then
            for i = 0 to count 
                punch(kin(get_def(db,"kin",i))*get_def(db,"volume",i))
            next i            
        endif
        if(  get_var("Cement::Output::Hydrates::Weights")  = 1 ) then
            for i = 0 to count 
                punch(kin(get_def(db,"kin",i))*get_def(db,"gfw",i))
            next i            
        endif
    endif
   
-end
END 
INCLUDE$ ModuleCementFigures/00_Definitions_02_LineStyleNumbers.hpi

CALCULATE_VALUES
ExtrOutputPunch
-state Definition
-mybasic
-start 
  txt = ""
  fignr = 1

  belements = 0
  belements_mg = 0
  
  bsolids = 0
  bsolidvol = 0
  bsolidgram = 0
  bsolid100 = 0
  convert =  get_var("Cement::Recipe::Amount") /100
  convertstr = " t " + chr(34) + "_THIS/" + str(convert) + chr(34) + " " 
  bylogscale = 0
  
  def WriteListElements()
    #print solution
    db = "Db_Elements"
    count = get_defnrrec(db)-1
    for i = 0 to count 

        txt = txt + "-fig_y " + get_def(db,i) + " < k " +  chr(34) + get_def(db,i) + chr(34) + " "
        if(belements_mg = 1 ) then
            txt = txt + " t " + chr(34) + "_THIS * 1000 * " + str(gfw(get_def(db,i))) + chr(34) + " "  
        endif
        txt = txt + " > " + eol
    next i

  enddef
  
  def WriteListSolids()
   dbn = get_var("_PhaseName$")
  #print kinetics - typically clinkers
    db = "Db_Kinetics"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        min = get_def(db,"kin",i)
        vary = min
        if(bsolidgram = 1 ) then
            if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
                vary = "w"+vary
            endif
        endif
        if(bsolidvol = 1 ) then
            if( get_var("Cement::Output::Hydrates::Volumes") = 1 ) then
                vary = "v"+vary
            endif
        endif 
        
        
        if(get_defexist(dbn,0,min) > -1) then           
            minindex = get_deflabel(dbn,min)
            if(get_def(dbn,1,minindex) = "none") then
                kmin = min
            else
                kmin = get_def(dbn,1,minindex)
            endif
        else
            kmin = min
        endif
        txt = txt + "-fig_y " + vary + " < k " +  chr(34) + kmin + chr(34) + " "
        strvar = "nr"+get_def(db,"kin",i)
        if(get_varexist(strvar) = 0 ) then 
            txt = txt +  " ls " + str(get_var(strvar)) + " "
        endif
        if(bsolid100 = 1) then
            txt = txt + convertstr
        endif
        txt = txt + " > " + eol
    next i
  #print s_s
    db = "Db_SolidSolutions_Def"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        min = get_def(db,0,i)
        vary = min
        if(bsolidgram = 1 ) then
            if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
                vary = "w"+vary
            endif
        endif
        if(bsolidvol = 1 ) then
            if( get_var("Cement::Output::Hydrates::Volumes") = 1 ) then
                vary = "v"+vary
            endif
        endif 
        txt = txt + "-fig_y " + vary + " < k " +  chr(34) + min + chr(34) + " "
        strvar = "nr"+get_def(db,0,i)
        if(get_varexist(strvar) = 0 ) then 
            txt = txt +  " ls " + str(get_var(strvar)) + " "
        endif
        if(bsolid100 = 1) then
            txt = txt + convertstr
        endif
        txt = txt + " > " + eol
    next i
  #prin solid
    db = "Db_Minerals"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        min = get_def(db,i)
        vary = min
        if(bsolidgram = 1 ) then
            if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
                vary = "w"+vary
            endif
        endif
        if(bsolidvol = 1 ) then
            if( get_var("Cement::Output::Hydrates::Volumes") = 1 ) then
                vary = "v"+vary
            endif
        endif 
        if(get_defexist(dbn,0,min) > -1) then           
            minindex = get_deflabel(dbn,min)
            if(get_def(dbn,1,minindex) = "none") then
                kmin = min
            else
                kmin = get_def(dbn,1,minindex)
            endif
        else
            kmin = min
        endif        
        txt = txt + "-fig_y " + vary + " < k " +  chr(34) + kmin + chr(34) + " "
        strvar = "nr"+kmin
        if(get_varexist(strvar) = 0 ) then 
            txt = txt +  " ls " + str(get_var(strvar)) + " "
        endif
        if(bsolid100 = 1) then
            txt = txt + convertstr
        endif
        txt = txt + " > " + eol
    next i

  enddef
  
  def WriteFigure(name, xtype)
  write(" 101 ")  
          txt = txt + "-fig_nr " + str(fignr) + eol
           write(" 102 ")  
          txt1 = "INCLUDE$ " + name + ".plt "
           write(" 103 ")  
          txt = txt + txt1  + eol
           write(" 104 ") 
          txt = txt + "-fig_variabletype " + chr(34) + xtype + chr(34)  + " " + eol
           write(" 104 ")  
          if(get_varexist("Cement::Figures::X::Column") > -1) then
             txt = txt + "-fig_x " + get_var("Cement::Figures::X::Column$") + eol    
          endif
           write(" 105 ")  
          txt = txt + "-fig_xt " +  chr(34) + get_var("Cement::Figures::X::Title$") +  chr(34) + " " + eol
          write(" 1 ")         
          if(belements = 1) then
              WriteListElements()
          endif
          if(bsolids = 1) then
              WriteListSolids()
          endif
          write(" 2 ")         
          txt = txt + "-fig_start " + eol
          bgrid = 0
          if(xtype = "Logscale") then
             txt = txt + "set logscale x " + eol
             txt = txt + "set mxtics 10 " + eol
             txt = txt + "set xtics format " + chr(34) + "10^{%T}" + chr(34) + " " + eol
             txt = txt + "set xtics 10 logscale " + eol
             txt = txt + "set grid "
             if( get_var("Cement::Figures::X::Grid$") = "Both" or get_var("Cement::Figures::X::Grid$") = "Both log" ) then
                 txt = txt + " xtics mxtics " 
                 bgrid = 1
             elseif (get_var("Cement::Figures::X::Grid$") = "Major" or get_var("Cement::Figures::X::Grid$") = "Major log") then
                 txt = txt + " xtics nomxtics " 
                 bgrid = 1
             else
                txt = txt + " noxtics nomxtics " 
             endif
          else
             txt = txt + "set grid "
             if( get_var("Cement::Figures::X::Grid$") = "Both" ) then
                 txt = txt + " xtics mxtics " 
                 bgrid = 1
             elseif (get_var("Cement::Figures::X::Grid$") = "Major" ) then
                 txt = txt + " xtics nomxtics " 
                 bgrid = 1
             else
                txt = txt + " noxtics nomxtics " 
             endif
          endif
          
          write(" 3 ")         
          if(bylogscale = 1) then
              if( get_var("Cement::Figures::Y::Grid$") = "Both" or get_var("Cement::Figures::Y::Grid$") = "Both Log" ) then
                  txt = txt + " ytics mytics " 
                  bgrid = 1
              elseif (get_var("Cement::Figures::Y::Grid$") = "Major" or get_var("Cement::Figures::Y::Grid$") = "Major Log" ) then
                  txt = txt + " ytics nomytics " 
                  bgrid = 1
              else
                  txt = txt + " noytics nomytics " 
              endif 
          else 
              if( get_var("Cement::Figures::Y::Grid$") = "Both" ) then
                  txt = txt + " ytics mytics " 
                  bgrid = 1
              elseif (get_var("Cement::Figures::Y::Grid$") = "Major" ) then
                  txt = txt + " ytics nomytics " 
                  bgrid = 1
              else
                  txt = txt + " noytics nomytics " 
              endif 
          endif 
          
          write(" 4 ")         
          txt = txt + " lt 1001, lt 1002 " + eol
          if (bgrid = 0) then
              txt = txt + "unset grid " + eol
          endif
          if(bylogscale = 1) then
              txt = txt + "set logscale y" + eol
              txt = txt + "set mytics 10 " + eol
              txt = txt + "set ytics format " + chr(34) + "10^{%T}" + chr(34) + " " + eol
              txt = txt + "set ytics 10 logscale " + eol
          endif
          txt = txt + "-fig_end " + eol
          
          fignr = fignr+1
          
          write(" 5 ")         
  enddef
  
  def WriteSolidFigures(j, _is, _ie, water, xtype )
   write(" 501 ") 
    if (j = 1) then
        un = ""
        una = ""
       bsolid100 = 0
    else
       un = "_100g"
       una = " - per 100 g"
       bsolid100 = 1
    endif
       write(" 502 ") 
    if(water = 1) then
        swater = " "
    else
        swater = "- no water"
    endif
       write(" 503 ") 
    for i = _is to _ie
        if(  string.find(get_var("Cement::Figures::Soilds::Value$"),"Moles")>-1 or  get_var("Cement::Figures::Soilds::Value$") = "All") then  
            WriteFigure("Solids_Moles"+un,xtype)
            if(i=1) then
                txt = txt + "-fig_name " + chr(34) + "SolidsMoles - Lines" + una + swater + chr(34) + " " + eol
            else 
                txt = txt + "-fig_name " + chr(34) + "SolidsMoles - Stacked" + una + swater + chr(34) + " " + eol
                if( get_var("Cement::Figures::Solids::StackType$") = "Filled"  ) then
                    txt = txt + "-fig_type ST_F_X" + eol
                elseif ( get_var("Cement::Figures::Solids::StackType$") = "Lines" ) then
                    txt = txt + "-fig_type ST_L_X" + eol
                else
                      txt = txt + "-fig_type ST_FL_X" + eol
                endif
            endif                    
            if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
              txt = txt + "-fig_showzero false " + eol
            endif
            txt = txt + eol
        endif
        if(  string.find(get_var("Cement::Figures::Soilds::Value$"),"Grams")>-1 or  get_var("Cement::Figures::Soilds::Value$") = "All") then  
            bsolidgram = 1
            WriteFigure("Solids_Grams"+un,xtype)
            bsolidgram = 0
            if(i=1) then
                txt = txt + "-fig_name " + chr(34) + "SolidsGrams - Lines" + una + swater + chr(34) + " " + eol
            else 
               txt = txt + "-fig_name " + chr(34) + "SolidsGrams - Stacked" + una + swater + chr(34) + " " + eol
                if( get_var("Cement::Figures::Solids::StackType$") = "Filled"  ) then
                    txt = txt + "-fig_type ST_F_X" + eol
                elseif ( get_var("Cement::Figures::Solids::StackType$") = "Lines" ) then
                    txt = txt + "-fig_type ST_L_X" + eol
                else
                      txt = txt + "-fig_type ST_FL_X" + eol
                endif
            endif                    
            if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
              txt = txt + "-fig_showzero false " + eol
            endif
            txt = txt + eol
        endif
        if(  string.find(get_var("Cement::Figures::Soilds::Value$"),"Volumes")>-1 or  get_var("Cement::Figures::Soilds::Value$") = "All") then  
            bsolidvol = 1
            WriteFigure("Solids_Volume"+un,xtype)
            bsolidvol = 0
            if(i=1) then
                txt = txt + "-fig_name " + chr(34) + "SolidsVolume - Lines" + una + swater + chr(34) + " " + eol
            else 
            txt = txt + "-fig_name " + chr(34) + "SolidsVolume - Stacked" + una + swater + chr(34) + " " + eol
                if( get_var("Cement::Figures::Solids::StackType$") = "Filled"  ) then
                    txt = txt + "-fig_type ST_F_X" + eol
                elseif ( get_var("Cement::Figures::Solids::StackType$") = "Lines" ) then
                    txt = txt + "-fig_type ST_L_X" + eol
                else
                      txt = txt + "-fig_type ST_FL_X" + eol
                endif
            endif                    
            if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
              txt = txt + "-fig_showzero false " + eol
            endif
            if(water = 1 ) then
                txt = txt + "-fig_y water < k " +  chr(34) + "Capillary water" + chr(34) + " ls " + str(get_var("nrCapWat")) + " t " + chr(34) + "_THIS*1000" + chr(34) + " > " + eol
            endif
            if(get_varexist("Cement::_hydration") = 0) then
                vola = get_var("Cement::Composition::Volume0")
                vol = str(vola)
                vola = floor(vola/10)
                vol1 = str(10*(vola+1))
                 txt = txt + "-fig_start " + eol
                 txt = txt + "set arrow 901 from graph 0, first " + vol + " to graph 1, first " + vol + " lt 1003 nohead front " + eol
                 txt = txt + "set yrange [0:" + vol1 + "] " + eol
                 txt = txt + "-fig_end " + eol
                 put_var("Output::InitialVolume",901)
            endif
            txt = txt + eol
         endif
    next i  
  enddef 
  
  def WriteFigures(xtype)

    if( get_var("Cement::Figures::pH") = 1) then 
        WriteFigure("Waterchemistry_pH",xtype)
        txt = txt + eol
    endif

    if( get_var("Cement::Figures::Water::Elements") = 1) then 
        belements = 1
        if( get_var("Cement::Figures::Water::Elements::Y::Scale$") = "Linear") then
            _is = 1
            _ie = 1
        elseif ( get_var("Cement::Figures::Water::Elements::Y::Scale$") = "Logscale") then
            _is = 2
            _ie = 2
        else
            _is = 1
            _ie = 2
        endif
        for i = _is to _ie
        
            bylogscale = i- 1
            if( get_var("Cement::Figures::Water::Elements::Unit$") = "Moles" or  get_var("Cement::Figures::Water::Elements::Unit$") = "Both") then
                belements_mg = 0
                WriteFigure("Waterchemistry_Elements_M",xtype)
                if(bylogscale = 0) then
                    txt = txt + "-fig_name " + chr(34) + "Elements - M" + chr(34) + " " + eol
                else
                    txt = txt + "-fig_name " + chr(34) + "Elements - M - Log" + chr(34) + " " + eol
                endif
                if( get_var("Cement::Figures::Water::Elements::ShowZero") = 0 ) then
                    txt = txt + "-fig_showzero false " + eol
                endif
                txt = txt + eol
            endif    
            if( get_var("Cement::Figures::Water::Elements::Unit$") = "Milligrams" or  get_var("Cement::Figures::Water::Elements::Unit$") = "Both") then
                belements_mg = 1  
                WriteFigure("Waterchemistry_Elements_mg",xtype) 
                if(bylogscale = 0) then 
                    txt = txt + "-fig_name " + chr(34) + "Elements - mg" + chr(34) + " " + eol
                else
                    txt = txt + "-fig_name " + chr(34) + "Elements - mg - Log" + chr(34) + " " + eol
                endif 
                if( get_var("Cement::Figures::Water::Elements::ShowZero") = 0 ) then
                    txt = txt + "-fig_showzero false " + eol
                endif
                txt = txt + eol    
            endif
        next i
        belements = 0
        belements_mg = 0
        bylogscale = 0
    endif
    
    if( get_var("Cement::Figures::Solids") = 1 ) then
       bsolids = 1
       if(  get_var("Cement::Figures::Solids::Type$")  = "Lines") then
           _is = 1
           _ie = 1
       elseif (  get_var("Cement::Figures::Solids::Type$")  = "stacked") then
           _is = 2
           _ie = 2
       else
           _is = 1
           _ie = 2
       endif 
       if(  get_var("Cement::Figures::Solids::Unit$") = "Total") then
           _js = 1
           _je = 1
       elseif (  get_var("Cement::Figures::Solids::Unit$")  = "Per100g") then
           _js = 2
           _je = 2
       else
           _js = 1
           _je = 2
       endif 
   
       for j = _js to _je
           if(get_varexist("Cement::Figures::Solids::Water$") = 0) then
               if( get_var("Cement::Figures::Solids::Water$") = "Water" or  get_var("Cement::Figures::Solids::Water$") = "Both" ) then         
                   WriteSolidFigures(j, _is, _ie, 1, xtype )        
               endif 
               if( get_var("Cement::Figures::Solids::Water$") = "No water" or  get_var("Cement::Figures::Solids::Water$") = "Both" ) then
                   WriteSolidFigures(j, _is, _ie, 0, xtype )
               endif 
            else
                WriteSolidFigures(j, _is, _ie, 0, xtype )
            endif
            bsolid100 = 0 
         next j
         bsolids = 0        
    endif 
        
  enddef
  




#Main
  if( get_varexist("Cement::Figures") = 0 ) then
      if( get_var("Cement::Figures") = 1 ) then
          dir = get_var("_Managed$") + "12_modules/ModuleCementFigures"
          txt = txt + "INCLUDEPATH " +  dir + eol


          dir = dir + "\"
          
          txt = txt + "SELECTED_GRAPH " + eol 
          
          txt = txt + "-include " + dir + "00_Definitions_01_colors.plt"  + eol
          
          txt = txt + "-start " + eol
          if (get_var("Cement::Figures::X::Reverse") = 1 ) then
              txt = txt + " set xrange reverse " + eol
          endif
          txt = txt + "-end " + eol
          
          
      if(  get_var("Cement::Figures::X::Scale$") = "Linear" or get_var("Cement::Figures::X::Scale$") = "Both") then
              xtype = "Linear"
              WriteFigures(xtype)
      endif
      if(  get_var("Cement::Figures::X::Scale$") = "Logscale" or get_var("Cement::Figures::X::Scale$") = "Both") then
          xtype = "Logscale"
          WriteFigures(xtype)
      endif    
              
      endif
  endif

  openf("_graphs._in")
  writef(txt)
  closef()
    
-end


include$ _graphs._in

