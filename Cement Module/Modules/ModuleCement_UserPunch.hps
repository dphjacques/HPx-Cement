INCLUDE$ ModuleCement_UserPunch_Generic.hps


USER_PUNCH 
-mybasic

-headings Amount OPC GBFS SF FA LS MK wc
-headings @Output::Oxides 

-headings Lead
-headings water T pH mu
-headings @Output::Elements
include$ _txtheading._in
-headings CSH_Ca CSH_Si GelPores
-headings @Output::Zeolites
-headings @Output::Kineticsh
-headings @Output::HeatSums
-headings @Output::HydrationDegree
-headings AggVol IniCemVol CemVol HydratesVol ChemShrink
-start

    punch(  get_var("Cement::Recipe::Amount") )
    punch( get_var("Cement::Clinker::Amount") )
    bopc = 0
    if(get_var("Cement::Clinker::Amount") > 1) then
        bopc  =1
    endif
    bgbfs = 0
    bsf = 0
    bfa = 0
    bls = 0
    bmk = 0
    if(get_varexist("GBFS::Amount") > -1) then
        punch( get_var("GBFS::Amount") )
        bgbfs = 1
    else
        punch(0)
    endif 
    if(get_varexist("SF::Amount") > -1) then
        punch( get_var("SF::Amount") )
        bfa = 1
    else
        punch(0)
    endif 
    if(get_varexist("FA::Amount") > -1) then
        punch( get_var("FA::Amount") )
        bls = 1
    else
        punch(0)
    endif 
    if(get_varexist("LS::Amount") > -1) then
        punch( get_var("LS::Amount") )
        bsf = 1
    else
        punch(0)
    endif 
    if(get_varexist("MK::Amount") > -1) then
        punch( get_var("MK::Amount") )
        bmk = 1
    else
        punch(0)
    endif 
    punch( get_var("Cement::Recipe::w_c") )
    
    #print oxides
    db = "Db_Elements"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        ox=get_def(db,i)
        am = sys(ox)
        if(ox="Al") then am=am/2 endif
        if(ox="Fe") then am=am/2 endif
        if(ox="Na") then am=am/2 endif
        if(ox="K") then am=am/2 endif
        
        punch(am)
    next i 
    
    #print lead
    timestep = 0
    if(get_varexist("Cement::Leaching::Type$") = 0 ) then
        if(get_varexist("Leaching::Run::AddedWater")=0) then
            addedwater = get_var("Leaching::Run::TotalAmountAddedWater") + get_var("Leaching::Run::AddedWater")
            punch(addedwater)
            put_var("Leaching::Run::TotalAmountAddedWater",addedwater )
        else
          punch(0)
        endif
    elseif (get_varexist("Cement::Ingress::Type$") = 0 ) then
        _step = sys("[_step]")
        if ( get_var("Cement::Figures::Lead$") <> "null" ) then
            leadvar = get_var("Cement::Figures::Lead$")
            if(get_varexist(leadvar) = 0) then
                punch( _step*get_var(leadvar))
            else
                punch( _step)
            endif
        else
            punch( _step)
        endif
        if(get_var("Cement::Ingress::Type$") = "Components" ) then
            if(get_Var("Cement::Ingress::Components::Type$" )  = "Relative Moles" ) then
                #punch( _step*get_var("Cement::Ingress::Components::CO2")) 
                #punch( _step*get_var("Cement::Ingress::Components::SO3")) 
                #punch( _step*get_var("Cement::Ingress::Components::MgCl2")) 
                #punch( _step*get_var("Cement::Ingress::Components::NaCl")) 
            endif
        endif
    elseif ( get_var("Cement::Figures::Lead$") <> "null" ) then
        leadvar = get_var("Cement::Figures::Lead$")
        if(string.comparenocase(leadvar,"time") = 0) then
            punch(total_time())
            timestep= total_time() - get_var("_timestep")
            put_var("_timestep",total_time())
        elseif(get_varexist(leadvar) = 0) then
            punch(get_var(leadvar))
        else
            punch(get_var("_leadnr"))
            put_var("_leadnr",get_var("_leadnr")+1)
        endif 
    else
        punch(get_var("_leadnr"))
        put_var("_leadnr",get_var("_leadnr")+1) 
    endif 

    punch(tot("water"))
    punch(tc())
    punch(-la("H+"), mu())
    
    
    #print solution
    db = "Db_Elements"
    count = get_defnrrec(db)-1

    for i = 0 to count 
        punch(tot(get_def(db,i)))
    next i
    
    #print minerals & ss
    if( get_var("Cement::Output::Hydrates::Moles") = 1 ) then
        db = "Db_Minerals"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(equi(get_def(db,i)))
        next i
        db = "Db_SolidSolutions"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(s_s(get_def(db,i)))
        next i
        
        db = "Db_SolidSolutions_Def"
        dba = "Db_SolidSolutions_Comp"
        count = get_defnrrec(db)-1

        for i = 0 to count 
            min = get_def(db,0,i)
            nr = get_def(db,1,i)
            am= 0
            for j = 0 to nr-1
                am = am + s_s(get_def(dba,i,j))
            next j
            punch(am)
        next i      
        
    endif 
    if(  get_var("Cement::Output::Hydrates::Volumes")  = 1 ) then
        db = "Db_Minerals"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(equi(get_def(db,i))*phase_vm(get_def(db,i)))
        next i
        db = "Db_SolidSolutions"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            punch(s_s(get_def(db,i))*phase_vm(get_def(db,i)))
        next i
        
        db = "Db_SolidSolutions_Def"
        dba = "Db_SolidSolutions_Comp"
        count = get_defnrrec(db)-1

        for i = 0 to count 
            min = get_def(db,0,i)
            nr = get_def(db,1,i)
            am= 0
            for j = 0 to nr-1
            am = am + s_s(get_def(dba,i,j))*phase_vm(get_def(dba,i,j))
            next j
            punch(am)
        next i 
    endif 
    if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
        db = "Db_Minerals"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            w= gfw(phase_formula(get_def(db,i)))
            punch(equi(get_def(db,i))*w)
        next i
        db = "Db_SolidSolutions"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            w= gfw(phase_formula(get_def(db,i)))
            punch(s_s(get_def(db,i))*w)
        next i
        
        db = "Db_SolidSolutions_Def"
        dba = "Db_SolidSolutions_Comp"
        count = get_defnrrec(db)-1
        for i = 0 to count 
            min = get_def(db,0,i)
            nr = get_def(db,1,i)
            am= 0
            for j = 0 to nr-1
                w= gfw(phase_formula(get_def(dba,i,j)))
                am = am + s_s(get_def(dba,i,j))*w
            next j
            punch(am)
        next i 
    endif 
    
    
    #saturation Index
    if(get_varexist("Cement::Output::Hydrates::SaturationIndex") = 0 ) then
       if(get_var("Cement::Output::Hydrates::SaturationIndex") = 1 ) then   
           db = "Db_Minerals"
           count = get_defnrrec(db)-1
            for i = 0 to count 
                punch(si(get_def(db,i)))
            next i  
            #db = "Db_SolidSolutions"
            #count = get_defnrrec(db)-1
            #for i = 0 to count 
            #  punch(si(get_def(db,i)))
            #next i  
       endif
    endif
    
    #heat
    if(get_varexist("Cement::Output::Hydrates::Heat") = 0 ) then
        if(get_var("Cement::Output::Hydrates::Heat") = 1 ) then 
            db = "Db_Minerals"
            count = get_defnrrec(db)-1
            sumphases = 0
            for i = 0 to count 
                phase = get_def(db,i)
                n = equi_delta(phase)
                dh = delta_h_phase(phase) 
                Q = n*dh
                sumphases = sumphases + Q
                if(get_varexist("cCumQ" + phase)=0) then
                    cumq = get_var("cCumQ" + phase)+Q                    
                else
                    cumq = Q
                endif
                put_var("cCumQ" + phase,cumq)
                if(timestep>0) then
                    Q = Q /timestep
                endif
                punch(Q)
                if(get_var("Cement::Output::Hydrates::CumHeat") = 1 ) then
                   punch(cumq)
                endif
            next i
  
            db = "Db_SolidSolutions"
            count = get_defnrrec(db)-1
            sums_s = 0
            for i = 0 to count 
                phase = get_def(db,i)
                n = s_s_delta(phase)
                dh = delta_h_phase(phase) 
                Q = n*dh
                sums_s = sums_s + Q
                if(get_varexist("cCumQ" + phase)=0) then
                    cumq = get_var("cCumQ" + phase)+Q
                else
                    cumq = Q
                endif
                put_var("cCumQ" + phase,cumq)
                if(timestep>0) then
                    Q = Q /timestep
                endif
                punch(Q)
                if(get_var("Cement::Output::Hydrates::CumHeat") = 1 ) then
                   punch(cumq)
                endif
            next i
 
 
            
        endif
     endif
    
    
    ca = sum_s_s("CSH","Ca")
    sil = sum_s_s("CSH","Si")
    if(ca > 0 AND sil > 0) then
        punch(ca,sil)
        VolumeGelPores=calc_value("VolumeGelPores",ca,sil)*sil*18
    else
        ca =1.6* equi("CSH1.6") + 1.2* equi("CSH1.2") +0.8* equi("CSH0.8")
        sil = equi("CSH1.6") + equi("CSH1.2") + equi("CSH0.8")
        punch(ca,sil)
        VolumeGelPores = 0
    endif
    punch(VolumeGelPores) 
    
    #Zeolites
    #0 zeo 1 na 2 k 3 ca 4 si 5 al
    if (get_varexist("Cement::Model::Zeolites::Na") = 0) then
       if (get_var("Cement::Model::Zeolites::Na") = 1) then
           db = "Db_ZeolitesNa"
           count = get_defnrrec(db)-1
           nao = 0
           ko = 0
           cao = 0
           sio = 0
           alo = 0
           for i = 0 to count 
               am = equi(get_def(db,0,i))

               nao = nao + get_def(db,1,i)*am 
               ko =  ko  + get_def(db,2,i)*am 
               cao = cao + get_def(db,3,i)*am 
               sio = sio + get_def(db,4,i)*am 
               alo = alo + get_def(db,5,i)*am 
           next i
           punch(nao, sio, alo)
       endif
    endif
    if (get_varexist("Cement::Model::Zeolites::K") = 0) then
        if (get_var("Cement::Model::Zeolites::K") = 1) then
            db = "Db_ZeolitesK"
            count = get_defnrrec(db)-1
           nao = 0
           ko = 0
           cao = 0
           sio = 0
           alo = 0
           for i = 0 to count 
               am = equi(get_def(db,0,i))
               nao = nao + get_def(db,1,i)*am 
               ko =  ko  + get_def(db,2,i)*am 
               cao = cao + get_def(db,3,i)*am 
               sio = sio + get_def(db,4,i)*am 
               alo = alo + get_def(db,5,i)*am 
           next i
           punch(ko, sio, alo)
       endif
    endif
    if (get_varexist("Cement::Model::Zeolites::Ca") = 0) then
        if (get_var("Cement::Model::Zeolites::Ca") = 1) then
           db = "Db_ZeolitesCa"
           count = get_defnrrec(db)-1
           nao = 0
           ko = 0
           cao = 0
           sio = 0
           alo = 0
           for i = 0 to count  
               am = equi(get_def(db,0,i))
               nao = nao + get_def(db,1,i)*am 
               ko =  ko  + get_def(db,2,i)*am 
               cao = cao + get_def(db,3,i)*am 
               sio = sio + get_def(db,4,i)*am 
               alo = alo + get_def(db,5,i)*am 
           next i
           punch(cao, sio, alo)
       endif
    endif
    
    #Kinetics
    if (get_varexist("Cement::_hydration") = 0) then
        db = "Db_Kinetics"
        count = get_defnrrec(db)-1
        if( get_var("Cement::Output::Hydrates::Moles") = 1 ) then
            for i = 0 to count 
                if(total_time() = 0) then
                    punch(get_def(db,"inimol",i))
                else
                    punch(kin(get_def(db,"kin",i)))
                endif
            next i
        endif
        if(  get_var("Cement::Output::Hydrates::Volumes")  = 1 ) then
            for i = 0 to count
                if(total_time() = 0) then
                    punch(get_def(db,"inivol",i))
                else            
                    punch(kin(get_def(db,"kin",i))*get_def(db,"volume",i))
                endif
            next i            
        endif
        if(  get_var("Cement::Output::Hydrates::Weights")  = 1 ) then
            for i = 0 to count
                if(total_time() = 0) then
                    punch(get_def(db,"iniweight",i))
                else         
                    punch(kin(get_def(db,"kin",i))*get_def(db,"gfw",i))
                endif
            next i            
        endif
        if(get_varexist("Cement::Output::Hydrates::Heat") = 0 ) then
            if(get_var("Cement::Output::Hydrates::Heat") = 1 ) then 
                sumkin = 0
                for i = 0 to count 
                    phase = get_def(db,"kin",i)
                    n = kin_delta(phase)
                    dh_t = get_def(db,"enthalpy",i)
                    if(string.comparenocase("STRING",str(type(dh_t))) = 0) then
                        dh= delta_h_phase(dh_t)
                     else
                        dh = dh_t/1000
                    endif 
                    Q = n*dh
                    sumkin = sumkin + Q
                    if(get_varexist("cCumQ" + phase)=0) then
                        cumq = get_var("cCumQ" + phase)+Q
                    else
                        cumq = Q
                    endif
                    put_var("cCumQ" + phase,cumq)
                    if(timestep>0) then
                        Q = Q /timestep
                    endif
                    punch(Q)
                    if(get_var("Cement::Output::Hydrates::CumHeat") = 1 ) then
                       punch(cumq)
                    endif
                next i
              endif
           endif
           
           
    endif

    #Heat
    if(get_varexist("Cement::Output::Hydrates::Heat") = 0 ) then
       if(get_var("Cement::Output::Hydrates::Heat") = 1 ) then 
           if(get_varexist("cCumHydrates") = 0 ) then
               put_var("cCumHydrates",get_var("cCumHydrates")+sumphases+sums_s)
           else
                put_var("cCumHydrates",sumphases+sums_s)
           endif
           if(get_varexist("cCumCement") = 0 ) then
               put_var("cCumCement",get_var("cCumCement")+sumkin)
           else
           put_var("cCumCement",sumkin)
           endif 
           if(timestep>0) then
               sumhydrates = (sumphases+sums_s)/timestep
               sumkin = sumkin / timestep
           else
                put_var("_InitialHeatProduction",get_var("cCumHydrates")) #variable accounting for the heat production of production of hydration due to initial equilibrium calculations)
           endif
           punch(sumhydrates,sumkin,sumhydrates+sumkin)
           punch(get_var("cCumHydrates"),get_var("cCumCement"),get_var("cCumHydrates")+get_var("cCumCement"))

               
       endif      
    endif

    #Hydration degree
    if(get_varexist("Cement::Output::Hydration::HydrationDegree") = 0 ) then
        if(get_var("Cement::Output::Hydration::HydrationDegree") = 1 ) then
            if (get_varexist("Cement::_hydration") = 0) then
                db = "Db_Kinetics"
                count = get_defnrrec(db)-1
                for i = 0 to count 
                    if(total_time() = 0 ) then
                        punch(0)
                    else 
                        punch(calc_value("CalculateHydrationDegree",get_def(db,"inimol",i),kin(get_def(db,"kin",i))))
                    endif
                next i
                if(total_time() = 0 ) then
                    punch(0)
                else
                    punch(calc_value("CalculateHydrationDegreeTotalOPC"))
                endif
            endif
        endif       
    endif
    
    #Summary graphs AggVol CemVol HydratesVol  ChemShrink
    #get_var("Cement::Composition::Volume0")
    punch(0) #aggregates - not included
    db = "Db_Minerals"
    count = get_defnrrec(db)-1
    volhyd = 0
    for i = 0 to count 
        volhyd = volhyd + equi(get_def(db,i))*phase_vm(get_def(db,i))
    next i
    db = "Db_SolidSolutions"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        volhyd = volhyd + s_s(get_def(db,i))*phase_vm(get_def(db,i))
    next i
    volhyd = volhyd - VolumeGelPores
    if (get_varexist("Cement::_hydration") = 0) then
        db = "Db_Kinetics"
        count = get_defnrrec(db)-1
        volclink = 0
        for i = 0 to count
            if(total_time() = 0) then
                volclink = volclink + get_def(db,"inivol",i)
            else            
                volclink = volclink + kin(get_def(db,"kin",i))*get_def(db,"volume",i)
            endif
        next i    
        punch(get_var("Cement::Composition::VolumeTot0"),volclink, volhyd) 
        punch(get_var("Cement::Composition::VolumeTot0")-volclink-volhyd-VolumeGelPores-tot("water")*1000)      
    else
        inivolume = 0
        if(bopc=1) then
            if(get_var("Cement::Clinker::BulkDensity") < 0) then bbulkdensity = 0
            inivolume = inivolume + get_var("Cement::Clinker::Amount") / get_var("Cement::Clinker::BulkDensity") 
        endif
        if(bgbfs = 1) then
            inivolume = inivolume +  get_var("GBFS::Amount") / get_var("GBFS::BulkDensity") 
        endif
        if(bsf = 1) then
            inivolume = inivolume +  get_var("SF::Amount") / get_var("SF::BulkDensity") 
        endif
        if(bfa = 1) then
            inivolume = inivolume +  get_var("FA::Amount") / get_var("FA::BulkDensity") 
        endif
        if(bls = 1) then
            inivolume = inivolume +  get_var("LS::Amount") / get_var("LS::BulkDensity") 
        endif
        if(bmk = 1) then
            inivolume = inivolume +  get_var("MK::Amount") / get_var("MK::BulkDensity") 
        endif
        inivolume = inivolume *  get_var("Cement::Recipe::Amount") /100
        
        punch(inivolume, 0, volhyd) 
        punch(inivolume+  get_var("Cement::Recipe::Amount") * get_var("Cement::Recipe::w_c") -volclink-volhyd-VolumeGelPores-tot("water")*1000)
    endif
    
    punch(delta_h_phase("C2S"),gfw(phase_formula("C2S")))
-end
END 
INCLUDE$ ModuleCementFigures/00_Definitions_02_LineStyleNumbers.hpi

CALCULATE_VALUES
ExtrOutputPunch
-state Definition
-mybasic
-start 
  txt = ""
  fignr = 1

  belements = 0
  belements_mg = 0
  
  bsolids = 0
  bsolidvol = 0
  bsolidgram = 0
  bsolid100 = 0
  convert =  get_var("Cement::Recipe::Amount") /100
  convertstr = " t " + chr(34) + "_THIS/" + str(convert) + chr(34) + " " 
  bylogscale = 0
  
  def WriteListElements()
    #print solution
    db = "Db_Elements"
    count = get_defnrrec(db)-1
    for i = 0 to count 

        txt = txt + "-fig_y " + get_def(db,i) + " < k " +  chr(34) + get_def(db,i) + chr(34) + " "
        if(belements_mg = 1 ) then
            txt = txt + " t " + chr(34) + "_THIS * 1000 * " + str(gfw(get_def(db,i))) + chr(34) + " "  
        endif
        txt = txt + " > " + eol
    next i

  enddef
  
  def WriteListSolids()
  #print kinetics - typically clinkers
    db = "Db_Kinetics"
    dbn = "PhaseName_kin"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        min = get_def(db,"kin",i)
        vary = min
        if(bsolidgram = 1 ) then
            if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
                vary = "w"+vary
            endif
        endif
        if(bsolidvol = 1 ) then
            if( get_var("Cement::Output::Hydrates::Volumes") = 1 ) then
                vary = "v"+vary
            endif
        endif 
        
        if(get_defexist(dbn,0,min) > -1) then           
            minindex = get_deflabel(dbn,min)
            if(get_def(dbn,1,minindex) = "none") then
                kmin = min)
            else
                kmin = get_def(dbn,1,minindex)
            endif
        else
            kmin = min
        endif 
        txt = txt + "-fig_y " + vary + " < k " +  chr(34) + kmin + chr(34) + " "
        strvar = "nr"+get_def(db,"kin",i)
        if(get_varexist(strvar) = 0 ) then 
            txt = txt +  " ls " + str(get_var(strvar)) + " "
        else
            txt = txt + " style lines " 
        endif
        if(bsolid100 = 1) then
            txt = txt + convertstr
        endif
        txt = txt + " > " + eol
    next i
  #print s_s  
    dbn = get_var("_PhaseName$")
    db = "Db_SolidSolutions_Def"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        min = get_def(db,0,i)
        vary = min
        if(bsolidgram = 1 ) then
            if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
                vary = "w"+vary
            endif
        endif
        if(bsolidvol = 1 ) then
            if( get_var("Cement::Output::Hydrates::Volumes") = 1 ) then
                vary = "v"+vary
            endif
        endif 
        txt = txt + "-fig_y " + vary + " < k " +  chr(34) + min + chr(34) + " "
        strvar = "nr"+get_def(db,0,i)
        if(get_varexist(strvar) = 0 ) then 
            txt = txt +  " ls " + str(get_var(strvar)) + " "
        endif
        if(bsolid100 = 1) then
            txt = txt + convertstr
        endif
        txt = txt + " > " + eol
    next i
  #prin solid
    db = "Db_Minerals"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        min = get_def(db,i)
        vary = min
        if(bsolidgram = 1 ) then
            if( get_var("Cement::Output::Hydrates::Weights") = 1 ) then
                vary = "w"+vary
            endif
        endif
        if(bsolidvol = 1 ) then
            if( get_var("Cement::Output::Hydrates::Volumes") = 1 ) then
                vary = "v"+vary
            endif
        endif 
        if(get_defexist(dbn,0,min) > -1) then           
            minindex = get_deflabel(dbn,min)
            if(get_def(dbn,1,minindex) = "none") then
                kmin = min
            else
                kmin = get_def(dbn,1,minindex)
            endif
        else
            kmin = min
        endif        
        txt = txt + "-fig_y " + vary + " < k " +  chr(34) + kmin + chr(34) + " "
        strvar = "nr"+kmin
        if(get_varexist(strvar) = 0 ) then 
            txt = txt +  " ls " + str(get_var(strvar)) + " "
        endif
        if(bsolid100 = 1) then
            txt = txt + convertstr
        endif
        txt = txt + " > " + eol
    next i

  enddef
  
  def WriteFigure(name, xtype)
          txt = txt + "-fig_nr " + str(fignr) + eol
          txt1 = "INCLUDE$ " + name + ".plt " 
          txt = txt + txt1  + eol
          txt = txt + "-fig_variabletype " + chr(34) + xtype + chr(34)  + " " + eol
          if(get_varexist("Cement::Figures::X::Column") > -1) then
             txt = txt + "-fig_x " + get_var("Cement::Figures::X::Column$") + eol    
          endif
          txt = txt + "-fig_xt " +  chr(34) + get_var("Cement::Figures::X::Title$") +  chr(34) + " " + eol      
          if(belements = 1) then
              WriteListElements()
          endif
          if(bsolids = 1) then
              WriteListSolids()
          endif
       
          txt = txt + "-fig_start " + eol
          bgrid = 0
          if(xtype = "Logscale") then
             txt = txt + "set logscale x " + eol
             txt = txt + "set mxtics 10 " + eol
             txt = txt + "set xtics format " + chr(34) + "10^{%T}" + chr(34) + " " + eol
             txt = txt + "set xtics 10 logscale " + eol
             txt = txt + "set grid "
             if( get_var("Cement::Figures::X::Grid$") = "Both" or get_var("Cement::Figures::X::Grid$") = "Both log" ) then
                 txt = txt + " xtics mxtics " 
                 bgrid = 1
             elseif (get_var("Cement::Figures::X::Grid$") = "Major" or get_var("Cement::Figures::X::Grid$") = "Major log") then
                 txt = txt + " xtics nomxtics " 
                 bgrid = 1
             else
                txt = txt + " noxtics nomxtics " 
             endif
          else
             txt = txt + "set grid "
             if( get_var("Cement::Figures::X::Grid$") = "Both" ) then
                 txt = txt + " xtics mxtics " 
                 bgrid = 1
             elseif (get_var("Cement::Figures::X::Grid$") = "Major" ) then
                 txt = txt + " xtics nomxtics " 
                 bgrid = 1
             else
                txt = txt + " noxtics nomxtics " 
             endif
          endif
                
          if(bylogscale = 1) then
              if( get_var("Cement::Figures::Y::Grid$") = "Both" or get_var("Cement::Figures::Y::Grid$") = "Both Log" ) then
                  txt = txt + " ytics mytics " 
                  bgrid = 1
              elseif (get_var("Cement::Figures::Y::Grid$") = "Major" or get_var("Cement::Figures::Y::Grid$") = "Major Log" ) then
                  txt = txt + " ytics nomytics " 
                  bgrid = 1
              else
                  txt = txt + " noytics nomytics " 
              endif 
          else 
              if( get_var("Cement::Figures::Y::Grid$") = "Both" ) then
                  txt = txt + " ytics mytics " 
                  bgrid = 1
              elseif (get_var("Cement::Figures::Y::Grid$") = "Major" ) then
                  txt = txt + " ytics nomytics " 
                  bgrid = 1
              else
                  txt = txt + " noytics nomytics " 
              endif 
          endif                

          txt = txt + " lt 1001, lt 1002 " + eol
          if (bgrid = 0) then
              txt = txt + "unset grid " + eol
          endif
          if(bylogscale = 1) then
              txt = txt + "set logscale y" + eol
              txt = txt + "set mytics 10 " + eol
              txt = txt + "set ytics format " + chr(34) + "10^{%T}" + chr(34) + " " + eol
              txt = txt + "set ytics 10 logscale " + eol
          endif
          txt = txt + "-fig_end " + eol
          
          fignr = fignr+1
       
  enddef
  
  def WriteSolidFigures(j, _is, _ie, water, xtype )
    if (j = 1) then
        un = ""
        una = ""
       bsolid100 = 0
    else
       un = "_100g"
       una = " - per 100 g"
       bsolid100 = 1
    endif
    if(water = 1) then
        swater = " "
    else
        swater = "- no water"
    endif
            WriteFigure("Solids_Moles_Eq"+un,xtype)
            txt = txt + "-fig_name " + chr(34) + "SolidsMoles " + una + swater + chr(34) + " " + eol                 
            if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
              txt = txt + "-fig_showzero false " + eol
            endif
            txt = txt + eol

            bsolidgram = 1
            WriteFigure("Solids_Grams_Eq"+un,xtype)
            bsolidgram = 0
            txt = txt + "-fig_name " + chr(34) + "SolidsGrams" + una + swater + chr(34) + " " + eol                   
            if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
              txt = txt + "-fig_showzero false " + eol
            endif
            txt = txt + eol
 
            bsolidvol = 1
            WriteFigure("Solids_Volume_Eq"+un,xtype)
            bsolidvol = 0
            txt = txt + "-fig_name " + chr(34) + "SolidsVolume" + una + swater + chr(34) + " " + eol                   
            if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
              txt = txt + "-fig_showzero false " + eol
            endif
            if(water = 1 ) then
                txt = txt + "-fig_y water < k " +  chr(34) + "Capillary water" + chr(34) + " ls " + str(get_var("nrCapWat")) + " t " + chr(34) + "_THIS*1000" + chr(34) + " > " + eol
            endif
            
            if(get_varexist("Cement::_hydration") = 0) then
                vola = get_var("Cement::Composition::VolumeTot0")
                vol = str(vola)
                vola = floor(vola/10)
                vol1 = str(10*(vola+1))
                 txt = txt + "-fig_start " + eol
                 txt = txt + "set arrow 901 from graph 0, first " + vol + " to graph 1, first " + vol + " lt 1003 nohead front " + eol
                 txt = txt + "set yrange [0:" + vol1 + "] " + eol
                 txt = txt + "-fig_end " + eol
                 put_var("Output::InitialVolume",901)
            endif
            txt = txt + eol
 
  enddef 
  
  def WriteFigures(xtype)

    if( get_var("Cement::Figures::pH") = 1) then 
        WriteFigure("Waterchemistry_pH",xtype)
        txt = txt + eol
    endif

    if( get_var("Cement::Figures::Water::Elements") = 1) then 
        belements = 1
        if( get_var("Cement::Figures::Water::Elements::Y::Scale$") = "Linear") then
            _is = 1
            _ie = 1
        elseif ( get_var("Cement::Figures::Water::Elements::Y::Scale$") = "Logscale") then
            _is = 2
            _ie = 2
        else
            _is = 1
            _ie = 2
        endif
        for i = _is to _ie
        
            bylogscale = i- 1
            if( get_var("Cement::Figures::Water::Elements::Unit$") = "Moles" or  get_var("Cement::Figures::Water::Elements::Unit$") = "Both") then
                belements_mg = 0
                WriteFigure("Waterchemistry_Elements_M",xtype)
                if(bylogscale = 0) then
                    txt = txt + "-fig_name " + chr(34) + "Elements - M" + chr(34) + " " + eol
                else
                    txt = txt + "-fig_name " + chr(34) + "Elements - M - Log" + chr(34) + " " + eol
                endif
                if( get_var("Cement::Figures::Water::Elements::ShowZero") = 0 ) then
                    txt = txt + "-fig_showzero false " + eol
                endif
                txt = txt + eol
            endif    
            if( get_var("Cement::Figures::Water::Elements::Unit$") = "Milligrams" or  get_var("Cement::Figures::Water::Elements::Unit$") = "Both") then
                belements_mg = 1  
                WriteFigure("Waterchemistry_Elements_mg",xtype) 
                if(bylogscale = 0) then 
                    txt = txt + "-fig_name " + chr(34) + "Elements - mg" + chr(34) + " " + eol
                else
                    txt = txt + "-fig_name " + chr(34) + "Elements - mg - Log" + chr(34) + " " + eol
                endif 
                if( get_var("Cement::Figures::Water::Elements::ShowZero") = 0 ) then
                    txt = txt + "-fig_showzero false " + eol
                endif
                txt = txt + eol    
            endif
        next i
        belements = 0
        belements_mg = 0
        bylogscale = 0
    endif
    

       if(get_varexist("Cement::Figures::Soilds::Value$")=0) then
            put_var("Cement::Figures::Solids::Value$",get_var("Cement::Figures::Soilds::Value$"))
       endif
       bsolids = 1


       #Plot detail information
       WriteSolidFigures(1, 1, 1, 1, xtype )
       bsolids = 0        

    
    if(get_varexist("Cement::Figures::Heat") = 0) then
        if( get_var("Cement::Figures::Heat") = 1) then 
            WriteFigure("Heat_rate_system",xtype)
            txt = txt + eol 
            WriteFigure("Heat_rate_binder",xtype)
            txt = txt + eol
            if( get_var("Cement::Output::Hydrates::CumHeat") = 1) then 
                WriteFigure("Heat_cum_system",xtype)
                txt = txt + eol
                WriteFigure("Heat_cum_binder",xtype)
                txt = txt + eol
            endif
        endif
    endif
    
    #General volumes or Fractions 
    if(get_varexist("Cement::Leaching::Type$") <> 0 ) then
		if( get_varexist("Cement::_hydration") = 0 ) then    
			WriteFigure("VolumeFraction",xtype)
		else  
			WriteFigure("VolumeFraction_Eq",xtype)
		endif
		txt = txt + "-fig_name " + chr(34) + "Volumes" + chr(34) + " " + eol                
		if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
		  txt = txt + "-fig_showzero false " + eol
		endif
		txt = txt + eol     
	endif
    
        #General / volumes
    if( get_varexist("Cement::_hydration") = 0 ) then        
        WriteFigure("HydrationDegree",xtype)
        txt = txt + "-fig_name " + chr(34) + "Hydration Degree" + chr(34) + " " + eol                
        if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
          txt = txt + "-fig_showzero false " + eol
        endif
        txt = txt + eol 
        WriteFigure("ChemicalShrinkage",xtype)
        txt = txt + "-fig_name " + chr(34) + "Chemical shrinkage" + chr(34) + " " + eol                
        if(  get_var("Cement::Figures::Solids::ShowZero")  = 0 ) then
          txt = txt + "-fig_showzero false " + eol
        endif
        txt = txt + eol     
    endif
    
  enddef
  

  def WriteTernaryFigures()
  
  txt_axis = "-fig_type ternary" + eol
  txt_axis = txt_axis + "-fig_variabletype " +  chr(34) + "ternary" + chr(34) + eol
  txt_axis = txt_axis + "-fig_x " + get_var("Cement::Figures::Ternary::X$") + eol
  txt_axis = txt_axis + "-fig_y " + get_var("Cement::Figures::Ternary::Y$") + eol
  txt_axis = txt_axis + "-fig_z " + get_var("Cement::Figures::Ternary::Z$") + eol     
  txt_axis = txt_axis + "-fig_xt " + chr(34) + get_var("Cement::Figures::Ternary::TitleX$") + chr(34) + eol
  txt_axis = txt_axis + "-fig_yt " + chr(34) + get_var("Cement::Figures::Ternary::TitleY$") + chr(34) + eol
  txt_axis = txt_axis + "-fig_zt " + chr(34) + get_var("Cement::Figures::Ternary::TitleZ$") + chr(34) + eol  
  if(get_var("Cement::Figures::Ternary::Grid") = 1) then
      txt_axix = txt_axis + "-fig_grid true false true" + eol
  endif
  
  if(get_var("Cement::Figures::Ternary::pH") = 1) then
    txt = txt + "-fig_nr " + str(fignr) + eol
    txt = txt + "-fig_group " + chr(34) + "Water chemistry" + chr(34) + eol
    txt = txt + "-fig_name " + chr(34) + "pH" + chr(34) + eol
    txt = txt + txt_axis
    txt = txt + "-fig_map pH < k " + chr(34) + "pH" + chr(34) + "> "+ eol + eol   
    fignr = fignr + 1
  endif
  
  if(get_var("Cement::Figures::Ternary::Water::Elements") = 1) then
    
    db = "Db_Elements"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        txt = txt + "-fig_nr " + str(fignr) + eol
        txt = txt + "-fig_group " + chr(34) + "Water chemistry" + chr(34) + eol
        txt = txt + "-fig_name " + chr(34) + "Element - Mol - " + get_def(db,i) + chr(34) + eol
        txt = txt + txt_axis 
        txt = txt + "-fig_map " + get_def(db,i) + " < k " +  chr(34) + get_def(db,i) + " [mol/l]" + chr(34) + " > " + eol+ eol
        fignr = fignr + 1
        #if(belements_mg = 1 ) then
        #    txt = txt + " t " + chr(34) + "_THIS * 1000 * " + str(gfw(get_def(db,i))) + chr(34) + " "  
        #endif

    next i
  endif 
  
  if(get_var("Cement::Figures::Ternary::Solids") = 1) then
    db = "Db_SolidSolutions_Def"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        txt = txt + "-fig_nr " + str(fignr) + eol
        txt = txt + "-fig_group " + chr(34) + "Solids - Mol/dm3" + chr(34) + eol
        txt = txt + "-fig_name " + chr(34) + get_def(db,0,i) + chr(34) + eol
        txt = txt + txt_axis 
        txt = txt + "-fig_map " + get_def(db,0,i) + " < k " +  chr(34) + get_def(db,0,i) + " [mol/dm^3]" + chr(34) + " > " + eol+ eol
        fignr = fignr + 1    
    next i
    
    db = "Db_Minerals"
    count = get_defnrrec(db)-1
    for i = 0 to count 
        txt = txt + "-fig_nr " + str(fignr) + eol
        txt = txt + "-fig_group " + chr(34) + "Solids - Mol/dm3" + chr(34) + eol
        txt = txt + "-fig_name " + chr(34) + get_def(db,i) + chr(34) + eol
        txt = txt + txt_axis 
        txt = txt + "-fig_map " + get_def(db,i) + " < k " +  chr(34) + get_def(db,i) + " [mol/dm^3]" + chr(34) + " > " + eol+ eol
        fignr = fignr + 1    
    next i
  endif  
  

  
  
  enddef


#Main
 figures = false  
 if( get_varexist("Cement::Figures") = 0 ) then
      if( get_var("Cement::Figures") = 1 ) then
          figures = true
      endif
  endif
  if( get_varexist("Cement::Figures::Ternary") = 0 ) then
      if( get_var("Cement::Figures::Ternary") = 1 ) then
          figures = true
      endif
  endif
  if(figures) then
          dir = get_var("_Managed$") + "12_modules/ModuleCementFigures"
          txt = txt + "INCLUDEPATH " +  dir + eol


          dir = dir + "\"
          
          txt = txt + "SELECTED_GRAPH " + eol 
          
          txt = txt + "-include " + dir + "00_Definitions_01_colors.plt"  + eol
     endif
  if( get_varexist("Cement::Figures") = 0 ) then
      if( get_var("Cement::Figures") = 1 ) then       
          txt = txt + "-start " + eol
          if (get_var("Cement::Figures::X::Reverse") = 1 ) then
              txt = txt + " set xrange reverse " + eol
          endif
          txt = txt + "-end " + eol
          
          
          if(  get_var("Cement::Figures::X::Scale$") = "Linear" or get_var("Cement::Figures::X::Scale$") = "Both") then
              xtype = "Linear"
              WriteFigures(xtype)
          endif
          if(  get_var("Cement::Figures::X::Scale$") = "Logscale" or get_var("Cement::Figures::X::Scale$") = "Both") then
              xtype = "Logscale"
              WriteFigures(xtype)
          endif    
              
      endif
  endif
    if( get_varexist("Cement::Figures::Ternary") = 0 ) then
      if( get_var("Cement::Figures::Ternary") = 1 ) then
         txt = txt + "-start" + eol
         txt = txt + "set palette maxcolors 10" +eol
         txt = txt + "set palette model RGB" +eol
         txt = txt + "set palette defined (0 " + chr(34) + "web-blue" + chr(34) + " , 0.25 " + chr(34) + "light-blue" + chr(34) + ", 0.5 " + chr(34) + "web-green" + chr(34) + ", 0.75 " + chr(34) + "yellow" + chr(34) + " , 1.0 " + chr(34) + "red" + chr(34) + ")" +eol
         txt = txt + "-end" + eol
         WriteTernaryFigures();          
      endif
  endif

  openf("_graphs._in")
  writef(txt)
  closef()
    
-end


include$ _graphs._in

